[Statedef 1000]
type = S
movetype = A
physics = N
juggle = 0
ctrl = 0
anim = -1+(anim != 1000)*1001
velset = 0,0
poweradd = 0
sprpriority = 4

[State 1000,sound]
type = PlaySnd
trigger1 = animelemtime(3) = 0
value = s0,2
channel = 5

[State 1000,voice]
type = PlaySnd
trigger1 = animelemtime(3) = 0
value = s5,2
channel = 0

[State 1000,変数をrandom化]
type = VarRandom
trigger1 = time = 0
v = 9
range = 44
persistent = 0
ignorehitpause = 1

;[State 1000,変数を固定したい人用]
;type = VarSet
;trigger1 = time = 0
