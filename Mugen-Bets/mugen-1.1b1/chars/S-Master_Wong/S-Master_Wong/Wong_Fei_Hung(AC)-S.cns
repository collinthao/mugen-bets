;ignorehitpause = 1

[State 1000,通常攻撃用確認変数リセット]
type = VarSet
trigger1 = time = 0
var(4) = 0
ignorehitpause = 1

[State 1000,変数固定]
type = Null
triggerall = !ishelper
triggerall = var(0) != 0
triggerall = 1 || time = 0
trigger1 = 1 || var(2):= 0
trigger1 = 1 || var(3):= 0
trigger1 = 1 || var(4):= 0
trigger1 = 1 || var(7):= 0
trigger1 = 1 || var(16):= 1
