;=====================================================================
;Tontura(antes de um fatality, com cronômetro).
[Statedef 49999]
type    = S
movetype= H
physics = S
juggle  = 1
ctrl = 0
velset = 0,0
;Inimigo ficará com vida(life) igual a 1.
[State 49999, 1]
type = LifeSet
trigger1 = 1
value = 1
;O seu personagem ganha um pouco mais de energia, evitando um empate.
[State 49999, 2]
type = TargetLifeAdd
trigger1 = P2life <= 1
value = 1

[State 49999, Mudança]
type = ChangeState
trigger1 = P2StateNo = 7200 ;-> State do brutality.
value = 52000 ;-> Custom State para onde P2 é enviado.
ctrl = 0

[State 49999, Mudança]
type = ChangeState
trigger1 = P2StateNo = 8700 ;-> State do Friendship.
value = 53000 ;-> Custom State para onde P2 é enviado.
ctrl = 0

;Depois de 700 ticks sem que haja fatality, P2 morre.
[State 49999, 4]
type = LifeSet
trigger1 = Time = 700
trigger1 = P2StateNo != [8700,8900]
value = 0
;Depois de 700 ticks sem que haja fatality, P2 cai.
[State 49999, 3]
type = SelfState
trigger1 = Time = 700
trigger1 = P2StateNo != [8700,8900] ;Coloque aqui os números dos states dos fatalities.
value = 5050
ctrl = 0
;Inimigo fica tonto(dizzy)
[State 49999, 5]
type = ChangeAnim
triggerall = Anim != 5300
trigger1 = AnimExist(5300)
value = 5300

----------------------------------------------------------------------
;Custom State para onde P2 é enviado no Friendship.
[Statedef 53000]
type    = S
movetype= H
physics = S

[State 53000, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

;Vida vai a 0(zero) quando chegar a um determinado tempo.
[State 53000, 4]
type = LifeSet
trigger1 = Time >= 10
value = 0

;Animação do air do p2.Ela vai ficar no lugar dele no fim do golpe
[State 53000, explod]
type = Explod
trigger1 = !time
anim = 5300; animação de dizzy
ID =  5300
pos = 0,0
facing = 1
bindtime = 1
removetime = -1
shadow = 255,255,255

;Muda de posição e uma outra animação pode surgir no local.
[State 52000, 5]
type = PosSet
trigger1 = Time = 1 ;Nesse momento aparece o explod acima.
y = 1500

;Não grita no final
[State 53000, 6]
type = AssertSpecial
trigger1 = 1
flag = nokosnd

[State 53000, 7]
type = SelfState
trigger1 = Time >= 10 ;P2 voltará ao seu próprio CNS, mas já morto.
value = 5150

