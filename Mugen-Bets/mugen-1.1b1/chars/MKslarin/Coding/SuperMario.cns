; HIT_LIEDEAD
[Statedef 5150]
type = L
movetype = H
physics = N
sprpriority = -3
velset = 0,0

[State 5150, Anim] ;Normal anim
type = ChangeAnim
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, Anim] ;Hit up type anim
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, Anim] ;Match over anim
type = ChangeAnim
persistent = 0
;trigger1 = Time = 0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, Anim] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value = 5110

[State 5150, AssertSpecial]
type = AssertSpecial
trigger1 = PrevStateNo = 5151
flag = NoShadow
flag2 = Invisible

[State 5150, PosSet]
type = PosSet
trigger1 = PrevStateNo != 5151
y = 0

[State 5150, VelMul] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 5150] ;Friction
type = VelSet
trigger1 = Vel x < .05
persistent = 0
