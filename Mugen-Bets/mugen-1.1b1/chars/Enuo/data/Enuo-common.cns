triggerall=(root,var(23+ishelper(9651))&(1073741823))>=1048576
trigger1=((root,var(23+ishelper(9651))&(1073741823))/1048576) > 0
ID=400
anim=400 +((root,var(23+ishelper(9651))&(1073741823))/1048576/14)-((root,var(23+ishelper(9651))&(1073741823))/1048576/14/10*10)
postype=p1
pos=(6 -6*(((root,var(23+ishelper(9651))&(1073741823))/1048576/14) < 10))*facing,-28 + (target,Const(size.head.pos.y))
