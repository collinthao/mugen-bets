;---------------------------------------------------------------------------
; Knife swing
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 110
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2

[State 1000, 1]
type = PlaySnd
trigger1 = Time = 8
value = 0, 4

[State 1000, 4]
type = VelSet
trigger1 = AnimElem = 3
x = 5.5

[State 1000, 6] ;Opponent not near
type = HitDef
trigger1 = AnimElem = 3
attr = S, SA
animtype  = Hard
damage    = 55, 4
priority  = 4
guardflag = MA
pausetime = 7,7
sparkxy = -10,-40
sparkno = S8004
guard.sparkno = S8020
hitsound   = S5,7
guardsound = S6,0
ground.type = Low
ground.slidetime = 12
ground.hittime  = 15
ground.velocity = -7
air.velocity = -4,-2.5
fall = 1

[State : Go Stand/Fall after that]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(Pos Y<0,50,0)
ctrl =  ifelse(Pos Y<0,0,1)

