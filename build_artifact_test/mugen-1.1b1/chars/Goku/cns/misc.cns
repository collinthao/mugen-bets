;------------------------------------------------------------------------------
;ヘルパー感知
;------------------------------------------------------------------------------
[STATE ]
type = VarSet
TriggerAll = IsHelper(66670)
TriggerAll = prevstateno = 66670
trigger1=1
var(57) = 0;これはこのヘルパーがヘルパー感知をする為のヘルパーを放出したかを見る変数です
;これが0ならヘルパーを出してない
;1になってたらヘルパーを出してます、1F毎に計算します。
;何かAI補助用途にお使いください(トリガーはhelper(66670),var(57)です)
[STATE PlayerIDAdd]
type = Helper
TriggerAll = IsHelper(66670)
TriggerAll = prevstateno = 66670
trigger1=!NumPartner && NumEnemy = 1
trigger1=(NumHelper + Enemy(0),NumHelper) > var(56)
trigger1=1 || var(57) := 1
trigger2=!NumPartner && NumEnemy > 1
trigger2=(NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) > var(56)
trigger2=1 || var(57) := 1
trigger3=NumPartner && NumEnemy = 1
trigger3=(NumHelper + Partner,NumHelper + Enemy(0),NumHelper) > var(56)
trigger3=1 || var(57) := 1
trigger4=NumPartner && NumEnemy > 1
trigger4=(NumHelper + Partner,NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) > var(56)
trigger4=1 || var(57) := 1
trigger5=1
name = "EnemyHelper"
helpertype = player
id = 76700
stateno = 76700;←76700には使われてないStatedefの番号を入れてください、76700とかはあまり使われてないと思います
supermovetime = 2147483647
pausemovetime = 2147483647
[STATE ]
type = VarSet
TriggerAll = IsHelper(66670)
TriggerAll = prevstateno = 66670
trigger1=!NumPartner && NumEnemy = 1
var(56) = (NumHelper + Enemy(0),NumHelper) - 1
[STATE ]
type = VarSet
TriggerAll = IsHelper(66670)
TriggerAll = prevstateno = 66670
trigger1=!NumPartner && NumEnemy > 1
var(56) = (NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) - 1
[STATE ]
type = VarSet
TriggerAll = IsHelper(66670)
TriggerAll = prevstateno = 66670
trigger1=NumPartner && NumEnemy = 1
var(56) = (NumHelper + Partner,NumHelper + Enemy(0),NumHelper) - 1
[STATE ]
type = VarSet
TriggerAll = IsHelper(66670)
TriggerAll = prevstateno = 66670
trigger1=NumPartner && NumEnemy > 1
var(56) = (NumHelper + Partner,NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) - 1
