trigger1 = anim = 5012+(var(1)*(10000))
trigger2 = anim = 5002+(var(1)*(10000))
trigger3 = anim = 5030+(var(1)*(10000))
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

