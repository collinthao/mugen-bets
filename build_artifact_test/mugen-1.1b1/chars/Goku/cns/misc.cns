[state ]
type=null;DestroySelf
TriggerAll = IsHelper(66670)
TriggerAll = prevstateno = 76700
trigger1=1

[State 0, VarSet]
type = VarSet
TriggerAll = IsHelper(77760)
trigger1 = ishelper
fv = 35
value = 140;←の数字は敵の攻撃ヘルパーが横からどこまで近くにいたら感知するのかを設定します、デフォルトでは140
ignorehitpause = 1
[State 0, VarSet]
type = VarSet
TriggerAll = IsHelper(77760)
trigger1 = ishelper
fv = 36
value = 30;←の数字は敵の攻撃ヘルパーが自分より下にいてどこまで近くにいたら感知するのかを設定します、デフォルトでは30
ignorehitpause = 1
[State 0, VarSet]
type = VarSet
TriggerAll = IsHelper(77760)
trigger1 = ishelper
fv = 37
value = 180;←の数字は敵の攻撃ヘルパーが自分より上にいてどこまで近くにいたら感知するのかを設定します、デフォルトでは180
ignorehitpause = 1
[State 0, ChangeAnim];これは相手の当身しにくいhitdefを判断する為のAnimです、絶対に消さないで下さい
type = ChangeAnim
TriggerAll = IsHelper(77760)
trigger1 = 1
value = 76671;←76671には使われてないAnim番号を入れて下さい、66000とかはあまり被ってないかも？、入れるアニメはAnim.txtから拝借して下さい
ignorehitpause = 1
[State 11000, Turn]
type = Turn
TriggerAll = IsHelper(77760)
trigger1 = facing != root,facing
[State 11000, AssertSpecial]
type = AssertSpecial
TriggerAll = IsHelper(77760)
Trigger1 = 1
flag = NoShadow
flag2 = invisible
ignorehitpause = 1
[State 11000, NotHitBy]
type = NotHitBy
TriggerAll = IsHelper(77760)
Trigger1 = 1
value = SCA;ここは相手の当身しにくいhitdefを判断する為絶対に変えないで下さい
ignorehitpause = 1
[STATE BtR]
type = PosSet
TriggerAll = IsHelper(77760)
trigger1 = 1
x = Root,Pos x
y = Root,Pos y
ignorehitpause = 1
[State 0, 相手がガードしないように]
type = AttackDist
TriggerAll = IsHelper(77760)
trigger1 = 1
value = 0
ignorehitpause = 1

