;============================================================
;移動
;============================================================
[Statedef 20]
type    = S
physics = S
sprpriority = 0
hitcountpersist = 1

[State 40, 勝手に・・・防止]
type = ChangeState
trigger1 = var(1) = 8
value = 0
ctrl = 0

[State 40, 勝手に・・・防止]
type = ChangeState
trigger1 = var(59) > 0 ; AIフラグの変数
value = 0
ctrl = 1



[State 20, pos] ;前進する速度
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x) ;定数で設定した速度

[State 20, pos] ;後退する速度
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x) ;定数で設定した速度

[State 20, anim] ;前進するアニメに変更
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+(var(1)*(10000)) && Anim != 5+(var(1)*(10000))
trigger2 = Anim = 5+(var(1)*(10000)) && AnimTime = 0
value = 20+(var(1)*(10000))

[State 20, anim] ;後退するアニメに変更
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+(var(1)*(10000)) && Anim != 5+(var(1)*(10000))
trigger2 = Anim = 5+(var(1)*(10000)) && AnimTime = 0
value = 21+(var(1)*(10000))

[Statedef 21];前歩き
type    = S
physics = S
sprpriority = 0
hitcountpersist = 1
[State 40, 勝手に・・・防止]
type = ChangeState
trigger1 = var(1) = 8
value = 0
ctrl = 0
[State 40, 勝手に・・・防止]
type = ChangeState
Trigger1   = RoundState > 2
value = 0
ctrl = 1

[State 20, pos] ;前進する速度
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x) ;定数で設定した速度

[State 20, anim] ;前進するアニメに変更
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+(var(1)*(10000)) && Anim != 5+(var(1)*(10000))
trigger2 = Anim = 5+(var(1)*(10000)) && AnimTime = 0
value = 20+(var(1)*(10000))

[State 20, anim] ;後退するアニメに変更
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+(var(1)*(10000)) && Anim != 5+(var(1)*(10000))
trigger2 = Anim = 5+(var(1)*(10000)) && AnimTime = 0
value = 21+(var(1)*(10000))

[Statedef 22];後ろ歩き
type    = S
physics = S
sprpriority = 0
hitcountpersist = 1
[State 40, 勝手に・・・防止]
type = ChangeState
trigger1 = var(1) = 8
value = 0
ctrl = 0
[State 40, 勝手に・・・防止]
type = ChangeState
Trigger1   = RoundState > 2
value = 0
ctrl = 1

[State 20, pos] ;後退する速度
type = VelSet
trigger1 = 1
x = const(velocity.walk.back.x) ;定数で設定した速度

[State 20, anim] ;前進するアニメに変更
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+(var(1)*(10000)) && Anim != 5+(var(1)*(10000))
trigger2 = Anim = 5+(var(1)*(10000)) && AnimTime = 0
value = 20+(var(1)*(10000))

[State 20, anim] ;後退するアニメに変更
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+(var(1)*(10000)) && Anim != 5+(var(1)*(10000))
trigger2 = Anim = 5+(var(1)*(10000)) && AnimTime = 0
value = 21+(var(1)*(10000))


;============================================================
;ジャンプ開始
;============================================================
[Statedef 40]
type = S
physics = S
anim = 40+(var(1)*(10000))
ctrl = 0
sprpriority = 1
hitcountpersist = 1
[State 40, 勝手に・・・防止]
type = ChangeState
trigger1 = var(1) = 8
value = 0
ctrl = 0
[State 40, 勝手に・・・防止]
type = ChangeState
Trigger1   = var(59) > 0
value = 0
ctrl = 1

[State 40, var]
type = VarSet
TriggerAll = (Name ="Songoku" && AuthorName = "280gou")
trigger1 = Time = 0
sysvar(1) = 0

[State 40, var]
type = VarSet
trigger1 = Time = 0
var(5) = 0

[State 40, var];ロングジャンプ
type = VarSet
TriggerAll = (Name ="Songoku" && AuthorName = "280gou")
triggerall = var(59) <= 0
trigger1 = command = "longjump"
trigger2 = prevstateno = 101 && command = "holdfwd"
trigger3 = prevstateno = 252 && command = "holdup"
trigger4 = prevstateno = 525 && command = "holdup"
var(5) = 1

[State 40, var]
type = VarSet
TriggerAll = (Name ="Songoku" && AuthorName = "280gou")
trigger1 = var(59) <= 0
trigger1 = command = "holdfwd"
trigger2 = var(59) > 0
trigger2 = p2Movetype = H || Random <= 500 || EnemyNear(floor(fvar(31))),StateType = L
trigger3 = var(59) > 0
trigger3 = p2Movetype != H || Random <= 300 || EnemyNear(floor(fvar(31))),StateType != L
sysvar(1) = 1

[State 40, var]
type = VarSet
TriggerAll = (Name ="Songoku" && AuthorName = "280gou")
trigger1 = var(59) <= 0
trigger1 = command = "holdback"
trigger2 = var(59) > 0
trigger2 = p2Movetype != H
sysvar(1) = -1

[State 40, var]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, e]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[Statedef 41];前ジャンプ
type = S
physics = S
ctrl = 0
sprpriority = 1
hitcountpersist = 1

[State 40, 勝手に・・・防止]
type = ChangeState
trigger1 = var(1) = 8
value = 0
ctrl = 0

[State ]
Type = ChangeAnim
Value      = 40+(var(1)*(10000))
TriggerAll = 1
Trigger1   = Anim != 40+(var(1)*(10000))
IgnoreHitPause = 1

[State 40, var]
type = VarSet
TriggerAll = (Name ="Songoku" && AuthorName = "280gou")
trigger1 = Time = 0
sysvar(1) = 0

[State 40, var]
type = VarSet
trigger1 = Time = 0
var(5) = 0

[State 40, var]
type = VarSet
TriggerAll = (Name ="Songoku" && AuthorName = "280gou")
trigger1 = 1
sysvar(1) = 1

[State 40, var]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, e]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

