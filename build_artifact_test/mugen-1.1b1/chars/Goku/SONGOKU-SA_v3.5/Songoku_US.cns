TriggerAll = Time = 0
TriggerAll = NumHelper(99999)
TriggerAll = (Var(55)/10000%10 = [2,3]);10割スイッチ
TriggerAll = Var(59) = 10
TriggerAll = Alive && !IsHelper && RoundState = 2
TriggerAll = Ctrl && StateType != A
TriggerAll = EnemyNear(Floor(FVar(31))),StateType != A
TriggerAll = EnemyNear(Floor(FVar(31))),MoveType = H
TriggerAll = FVar(18) >= 11;ヒットタイム
Trigger1   = Helper(99999),Var(44) = 410;しゃがみ強パンチ
