var(0)     = (Var(0)|262144)
IgnoreHitPause = 1



[State 99999, ダメキャン用体力記憶]
Type = Null
TriggerAll = IsHelper(99999)
TriggerAll = Root,Var(50) > 0
;通常時
Trigger1   = Root,MoveType != H
Trigger1   = Root,Var(20) = GameTime*5
Trigger1   = 0 && Var(6) := Root,Life
;それ以外
Trigger2   = 0 && Var(7) := Root,Life
IgnoreHitPause = 1




[State 99999, 止めフラグOFF]
Type = VarSet
TriggerAll = IsHelper(99999)
Trigger1   = 1
var(10)    = 0
IgnoreHitPause = 1

[State 99999, 止めフラグ／Sかめはめ波]
Type = VarSet
TriggerAll = IsHelper(99999)
