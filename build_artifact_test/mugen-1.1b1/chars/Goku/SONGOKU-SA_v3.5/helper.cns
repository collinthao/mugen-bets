[State 99999, 当身後追撃判定]
Type = VarSet
TriggerAll = IsHelper(99999)
Trigger1   = 0 && Var(0) := (Var(0)|262144)-262144
Trigger2   = Root,StateNo = 1511 && (EnemyNear(Floor(Root,FVar(31))),StateNo = 1512 || (EnemyNear(Floor(Root,FVar(31))),StateNo = [9160,9161]))
Trigger3   = Root,StateNo = 1561 && (EnemyNear(Floor(Root,FVar(31))),StateNo = 1562 || (EnemyNear(Floor(Root,FVar(31))),StateNo = [9160,9161]))
