;(HELPER)敵攻撃ヘルパー感知ヘルパー(このヘルパーのvar(0)～var(57)は使わないで下さい、ヘルパー感知の為に使います)
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Statedef 66670]
type = A
velset = 0,0
movetype = I
physics = N
sprpriority = 0
Anim = 66671;←66671には使われてないAnim番号を入れて下さい、65000とかはあまり被ってないかも？、入れるアニメはAnim.txtから拝借して下さい
Ctrl = 0

[State 11000, 間違いで本体が来たら立ちへ移行]
type = SelfState
trigger1 = !ishelper
value = IfElse(Pos Y = 0,0,5040)
ctrl = 1
ignorehitpause = 1

[State 10000, Turn]
type = Turn
trigger1 = facing != root,facing

[State 10000, AssertSpecial]
type = AssertSpecial
Trigger1 = 1
flag = NoShadow
flag2 = invisible
ignorehitpause = 1

[State 10000, NotHitBy]
type = NotHitBy
Trigger1 = 1
value = SCA
ignorehitpause = 1

[STATE BtR]
type = PosSet
trigger1 = 1
x = Root,Pos x
y = Root,Pos y
ignorehitpause = 1

;------------------------------------------------------------------------------
;ヘルパー感知
;------------------------------------------------------------------------------
[STATE ]
type = VarSet
trigger1=1
var(57) = 0;これはこのヘルパーがヘルパー感知をする為のヘルパーを放出したかを見る変数です
;これが0ならヘルパーを出してない
;1になってたらヘルパーを出してます、1F毎に計算します。
;何かAI補助用途にお使いください(トリガーはhelper(66670),var(57)です)

[STATE PlayerIDAdd]
type = Helper
TriggerAll = Root,FVar(37) = 0
TriggerAll = Root,Var(1) > 5 && Root,Var(1) != 8
trigger1=!NumPartner && NumEnemy = 1
trigger1=(NumHelper + Enemy(0),NumHelper) > var(56)
trigger1=1 || var(57) := 1
trigger2=!NumPartner && NumEnemy > 1
trigger2=(NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) > var(56)
trigger2=1 || var(57) := 1
trigger3=NumPartner && NumEnemy = 1
trigger3=(NumHelper + Partner,NumHelper + Enemy(0),NumHelper) > var(56)
trigger3=1 || var(57) := 1
trigger4=NumPartner && NumEnemy > 1
trigger4=(NumHelper + Partner,NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) > var(56)
trigger4=1 || var(57) := 1
trigger5=1
name = "EnemyHelper"
helpertype = player
id = 76700
stateno = 76700;←76700には使われてないStatedefの番号を入れてください、76700とかはあまり使われてないと思います
supermovetime = 2147483647
pausemovetime = 2147483647
[STATE PlayerIDAdd]
type = Helper;IKEMEN
TriggerAll = Root,FVar(37) = 1
TriggerAll = Root,Var(1) > 5 && Root,Var(1) != 8
trigger1=!NumPartner && NumEnemy = 1
trigger1=(NumHelper + Enemy(0),NumHelper) > var(56)
trigger1=1 || var(57) := 1
trigger2=!NumPartner && NumEnemy > 1
trigger2=(NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) > var(56)
trigger2=1 || var(57) := 1
trigger3=NumPartner && NumEnemy = 1
trigger3=(NumHelper + Partner,NumHelper + Enemy(0),NumHelper) > var(56)
trigger3=1 || var(57) := 1
trigger4=NumPartner && NumEnemy > 1
trigger4=(NumHelper + Partner,NumHelper + Enemy(0),NumHelper + Enemy(1),NumHelper) > var(56)
trigger4=1 || var(57) := 1
trigger5=1
name = "EnemyHelper"
helpertype = Normal
id = 76700
stateno = 76700;←76700には使われてないStatedefの番号を入れてください、76700とかはあまり使われてないと思います
supermovetime = 2147483647
pausemovetime = 2147483647

[STATE ]
