[State , 時止め感知]
Type = VarSet
TriggerAll = IsHelper(99999)
Trigger1   = 0 && Var(15) := (Var(15)|16)-16
Trigger2   = Root,MoveType != H && !Root,MoveReversed
Trigger2   = Root,Var(17) != GameTime
var(15)    = (Var(15)|16)
IgnoreHitPause = 1

[State , ゲージ技感知ON]
Type = VarSet
TriggerAll = IsHelper(99999) && RoundState = 2
Trigger1   = (Var(15)&16) ;時止め感知
Trigger2   = (Var(15)&64) ;敵がパワーを消費した
var(15)    = (Var(15)|32)
IgnoreHitPause = 1

[State , ゲージ技感知の前提]
Type = Null
TriggerAll = IsHelper(99999)
Trigger1   = 0 && Var(15) := (Var(15)|64)-64
Trigger2   = (Var(19) - EnemyNear(Floor(Root,FVar(31))),Power) > 500;500以上パワーを消費した
Trigger2   = 0 && Var(15) := (Var(15)|64)
Trigger3   = 0 && Var(19) := EnemyNear(Floor(Root,FVar(31))),Power
IgnoreHitPause = 1

[State , ゲージ技中の敵ステート記憶]
Type = VarSet
TriggerAll = IsHelper(99999)
TriggerAll = Var(21) = 0   ;敵ステート記憶してない
Trigger1   = (Var(15)&32)  ;ゲージ技感知中
Trigger1   = EnemyNear(Floor(Root,FVar(31))),MoveType = A
var(21)    = IfElse((EnemyNear(Floor(Root,FVar(31))),StateNo=[120,155]),EnemyNear(Floor(Root,FVar(31))),PrevStateNo,EnemyNear(Floor(Root,FVar(31))),StateNo)
IgnoreHitPause = 1

[State , ゲージ技中の以外のヘルパー数とProj数]
Type = Null
TriggerAll = IsHelper(99999)
TriggerAll = !(Var(15)&32)  ;ゲージ技感知中以外
Trigger1   = 1 || Var(22) := EnemyNear(Floor(Root,FVar(31))),NumProj
Trigger1   = 1 || Var(22) := IfElse(Var(22)>9999999,9999999,Var(22))
Trigger1   = 1 || Var(22) := EnemyNear(Floor(Root,FVar(31))),NumHelper *10000000+(Var(22)/1%10000000000)
IgnoreHitPause = 1

[State , ゲージ技中にヘルパーとProjが増えたフラグ]
Type = VarSet
TriggerAll = IsHelper(99999)
Trigger1   = (Var(22)/1%10000000)   <= EnemyNear(Floor(Root,FVar(31))),NumProj   || !(Var(15)&32)
Trigger1   = (Var(22)/10000000%100) <= EnemyNear(Floor(Root,FVar(31))),NumHelper || !(Var(15)&32)
Trigger1   = 0 && Var(15) := (Var(15)|128)-128
Trigger2   = (Var(22)/1%10000000)   > EnemyNear(Floor(Root,FVar(31))),NumProj
Trigger3   = (Var(22)/10000000%100) > EnemyNear(Floor(Root,FVar(31))),NumHelper
var(15)    = (Var(15)|128)
IgnoreHitPause = 1

[State , ゲージ技感知OFF]
Type = VarSet
TriggerAll = IsHelper(99999)
;TriggerAll = !(Root,Var()&) || EnemyNear(Floor(Root,FVar(31))),MoveType = H; 本体の背後を取ってるかフラグ
TriggerAll = !Root,InGuardDist || EnemyNear(Floor(Root,FVar(31))),MoveType = H; 本体の背後を取ってるかフラグ
TriggerAll = !(Var(15)&16) ;時止め感知中以外
Trigger1   = Var(21) > 0   ;ゲージ技中の敵ステート
Trigger1   = (Var(22)/1%10000000)   <= EnemyNear(Floor(Root,FVar(31))),NumProj
;Trigger1   = (Var(22)/10000000%100) <= EnemyNear(Floor(Root,FVar(31))),NumHelper
Trigger1   = !(EnemyNear(Floor(Root,FVar(31))),StateNo = [120,155])
Trigger1   = !(Var(21) = [EnemyNear(Floor(Root,FVar(31))),StateNo-100,EnemyNear(Floor(Root,FVar(31))),StateNo+100])
Trigger2   = Var(21) > 0   ;ゲージ技中の敵ステート
Trigger2   = (Var(22)/1%10000000)   <= EnemyNear(Floor(Root,FVar(31))),NumProj
;Trigger2   = (Var(22)/10000000%100) <= EnemyNear(Floor(Root,FVar(31))),NumHelper
Trigger2   = (EnemyNear(Floor(Root,FVar(31))),StateNo = [120,155])
Trigger2   = !(Var(21) = [EnemyNear(Floor(Root,FVar(31))),PrevStateNo-100,EnemyNear(Floor(Root,FVar(31))),PrevStateNo+100])
Trigger3   = EnemyNear(Floor(Root,FVar(31))),MoveType = H
var(15)    = (Var(15)|32)-32
IgnoreHitPause = 1

[State , ゲージ技中の敵ステート記憶消去]
Type = VarSet
TriggerAll = IsHelper(99999)
Trigger1   = !(Var(15)&32) ;ゲージ技感知中
var(21)    = 0
IgnoreHitPause = 1

[State , 直前StateNo記憶]
Type = Null
TriggerAll = IsHelper(99999)
Trigger1   = Root,MoveType = H
Trigger1   = 0 && Var(24) := 0
Trigger2   = Root,StateNo >= 200
Trigger2   = 0 && Var(24) := Root,StateNo
IgnoreHitPause = 1





