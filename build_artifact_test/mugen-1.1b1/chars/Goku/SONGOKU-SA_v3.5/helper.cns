; 変数管理
[Statedef 99999]
type     = A
movetype = I
physics  = N

[State 99999, 本体が来たら抜け]
Type = SelfState
Trigger1 = !IsHelper
Value    = 0
Ctrl     = 1
IgnoreHitPause = 1

[State 99999, 見極め食らい抜け使用フラグ]
Type = VarSet
TriggerAll = IsHelper(99999)
Trigger1   = 0 && Var(0) := (Var(0)|1)-1
Trigger2   = (Root,Var(56)/10%10 = 9);見極め食らい抜け使用LV
Trigger3   = (Root,Var(56)/10%10 = 8);見極め食らい抜け使用LV
Trigger3   = Root,Var(39) >= 1       ;変身ランク
Trigger4   = (Root,Var(56)/10%10 = 7);見極め食らい抜け使用LV
Trigger4   = Root,Var(39) >= 2       ;変身ランク
