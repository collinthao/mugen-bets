[State 99999, エラメ対策]
Type = VarSet
TriggerAll = IsHelper(99999)
Trigger1   = 0 && Var(0) := (Var(0)|32)-32
Trigger2   = NumEnemy = 1
Trigger2   = NumPartner
Trigger2   = Partner,Alive = 0
Trigger3   = NumEnemy = 1
Trigger3   = NumPartner = 0
Trigger4   = NumEnemy >= 2
Trigger4   = NumPartner
Trigger4   = Partner,Alive = 0
Trigger4   = Enemy(0),Alive
Trigger4   = Enemy(1),Alive = 0
Trigger5   = NumEnemy >= 2
Trigger5   = NumPartner
Trigger5   = Partner,Alive = 0
Trigger5   = Enemy(0),Alive = 0
Trigger5   = Enemy(1),Alive
Trigger6   = NumEnemy >= 2
Trigger6   = NumPartner = 0
Trigger6   = Enemy(0),Alive
Trigger6   = Enemy(1),Alive = 0
Trigger7   = NumEnemy >= 2
Trigger7   = NumPartner = 0
Trigger7   = Enemy(0),Alive = 0
Trigger7   = Enemy(1),Alive
var(0)     = (Var(0)|32)
IgnoreHitPause = 1

