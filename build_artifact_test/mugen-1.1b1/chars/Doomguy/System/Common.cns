;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type = S
physics = S
sprpriority = 2

[State 0]
type = ChangeAnim
triggerall = !IsHelper && !Var(40)
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && !AnimTime
value = 0

[State 0]
type = PosSet
triggerall = !IsHelper
triggerall = Pos Y != 0
trigger1 = !Time
y = 0

[State 0]
type = VelSet
triggerall = !IsHelper
trigger1 = !Time
y = 0

[State 0]
type = VelSet
triggerall = !IsHelper
trigger1 = Abs(Vel x) < Const(Movement.Stand.Friction.Threshold)
trigger2 = Time = 4
x = 0

[State 0]
type = Turn
triggerall = !IsHelper
triggerall = !Time
trigger1 = (EnemyNear,Pos X-Pos X)*Facing<0

[State 0]
type = AfterImageTime
triggerall = !IsHelper
trigger1 = !Time
time = 1

[State 0]
type = SelfState
triggerall = !IsHelper
trigger1 = !Alive
value = 5050

;---------------------------------------------------------------------------
;Stand to Crouch
[Statedef 10]
type = C
physics = C
anim = 10

[State 10]
type = PosSet
triggerall = !IsHelper
trigger1 = Pos Y != 0
y = 0

[state 10]
type = VelSet
triggerall = !IsHelper
trigger1 = !Time
y = 0

[State 10]
type = VelSet
triggerall = !IsHelper
trigger1 = Abs(Vel x)<Const(Movement.Crouch.Friction.Threshold)
x = 0

[State 10]
type = VelMul
triggerall = !IsHelper
trigger1 = !Time
x = 0.75

[State 10]
type = Turn
triggerall = !IsHelper
triggerall = !Time
trigger1 = (EnemyNear,Pos X-Pos X)*Facing<0

[State 10]
type = SelfState
triggerall = !IsHelper
trigger1 = !AnimTime
value = 11

;---------------------------------------------------------------------------
;Crouching
[Statedef 11]
type = C
physics = C

[State 11, Null]
type = Null
triggerall = !IsHelper
triggerall = !Var(59)
trigger1 = Command = "holdfwd" ^^ Command = "holdback"	; If player's pressing "holdfwd" or "holdback" (one per time)
trigger1 = Var(0):= Cond(Command = "holdfwd",15,16)	; var(0) = 15 if pressing "holdfwd", var(0) = 16 if "holdback"
trigger2 = Var(0):= 11					; var(0) = 11 if none or both
 
[State 11, ChangeAnim] ;Change from turning animation
type = ChangeAnim
triggerall = !IsHelper
trigger1 = Cond(Anim = 6,!AnimTime,Anim != Var(0))
value = Var(0)
 
[State 11, VelSet]
type = VelSet
triggerall = !IsHelper
trigger1 = Anim!= [6,11]				; Set velocity if player isn't turning or just crouching
x = Cond(Anim = 15,2,-2)				; If walking fwd, set positive value. Else, negative value.
 
[State 11, VelSet] 					; Stop moving if low velocity (M.U.G.E.N 1.0+)
type = VelSet
triggerall = !IsHelper
trigger1 = Anim = 11									
trigger2 = Abs(Vel x) < Const(Movement.Crouch.Friction.Threshold)
x = 0

[State 11]
type = Turn
triggerall = !IsHelper
triggerall = !Time
trigger1 = (EnemyNear,Pos X-Pos X)*Facing<0

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=0
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S20,(Random%6)
volumescale = 255

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=1
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S21,(Random%6)
volumescale = 255

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=2
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S22,(Random%6)
volumescale = 255

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=3
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S23,(Random%6)
volumescale = 255

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=4
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S24,(Random%6)
volumescale = 255

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=5
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S25,(Random%5)
volumescale = 255

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=6
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S26,(Random%4)
volumescale = 255

[State 11, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=7
trigger1 = Anim = [15,16]
trigger1 = Time>=0 && (Time%25)=1
value = S27,(Random%6)
volumescale = 255

[State 11]
type = SelfState
triggerall = !IsHelper
triggerall = !Var(59)
trigger1 = Command != "holddown"
value = 12

