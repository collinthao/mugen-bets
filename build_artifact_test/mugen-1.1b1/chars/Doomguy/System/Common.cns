;---------------------------------------------------------------------------
;Air get-hit (fall recovery in air)
[Statedef 5210]
type = A
movetype = I
physics = N
anim = 5210
ctrl = 0

[State 5210, Turn]
type = Turn
triggerall = !IsHelper
trigger1 = !Time && P2Dist X < -20

[State 5210, FX]
type = PalFX
triggerall = !IsHelper
trigger1 = !Time
time = 3
add = 128,128,128

[State 5210, Vel]
type = VelAdd
triggerall = !IsHelper
trigger1 = Time = 4
x = Const(Velocity.Air.GetHit.AirRecover.Add.x)
y = Const(Velocity.Air.GetHit.AirRecover.Add.y)

[State 5210, Vel]
type = VelMul
triggerall = !IsHelper
trigger1 = Time = 4
x = Const(Velocity.Air.GetHit.AirRecover.Mul.x)
y = Const(Velocity.Air.GetHit.AirRecover.Mul.y)

[State 5210, Vel]
type = VelAdd
triggerall = !IsHelper
triggerall = Time = 4
trigger1 = !Var(59)
trigger1 = Command = "holdup"
trigger2 = Var(59)
trigger2 = Random%2
y = Const(Velocity.Air.GetHit.AirRecover.Up)

[State 5210, Vel]
type = VelAdd
triggerall = !IsHelper
triggerall = Time = 4
trigger1 = !Var(59)
trigger1 = Command = "holddown"
trigger2 = Var(59)
trigger2 = Random%2
y = Const(Velocity.Air.GetHit.AirRecover.Down)

[State 5210, Vel]
type = VelAdd
triggerall = !IsHelper
triggerall = Time = 4
trigger1 = !Var(59)
trigger1 = Command = "holdfwd"
trigger2 = Var(59)
trigger2 = Random%2
x = Const(Velocity.Air.GetHit.AirRecover.Fwd)

[State 5210, Vel]
type = VelAdd
triggerall = !IsHelper
triggerall = Time = 4
trigger1 = !Var(59)
trigger1 = Command = "holdback"
trigger2 = Var(59)
trigger2 = Random%2
x = Const(Velocity.Air.GetHit.AirRecover.Back)

[State 5210] ;Normalize vel
type = VelSet
triggerall = !IsHelper
trigger1 = Time = 4
x = Cond(Abs(Vel x)>5,5*Vel x/(Abs(Vel x)),Vel x)
y = Cond(Vel y>-1,-1,Vel y)

[State 5210, Vel]
type = VelAdd
triggerall = !IsHelper
trigger1 = Time >= 4
y = Const(Movement.Air.GetHit.AirRecover.Yaccel)

[State 5210, NHB]
type = NotHitBy
triggerall = !IsHelper
trigger1 = !Time
value = SCA
time = 15

[State 5210, Ctrl]
type = CtrlSet
triggerall = !IsHelper
trigger1 = Time > 20
value = 1

[State 5210, Self]
type = SelfState
triggerall = !IsHelper
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 52
ctrl = 1

