trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && !AnimTime
value = 20

[State 20]
type = ChangeAnim
triggerall = !IsHelper
triggerall = Vel X < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && !AnimTime
value = 21

[State 20]
type = VelSet
triggerall = !IsHelper
triggerall = !Var(59)
trigger1 = Command = "holdfwd"
x = Const(Velocity.Walk.Fwd.X)

[State 20]
type = VelSet
triggerall = !IsHelper
triggerall = !Var(59)
trigger1 = Command = "holdback"
x = Const(Velocity.Walk.Back.X)

[State 20]
type = VelSet
triggerall = !IsHelper
triggerall = Var(59)
trigger1 = !Time
x = Const(Velocity.Walk.Fwd.X)

[state 20]
type = PosSet
triggerall = !IsHelper
trigger1 = Pos Y != 0
y = 0

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=0
trigger1 = Time>=0 && (Time%25)=1
value = S20,(Random%6)
volumescale = 255

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=1
trigger1 = Time>=0 && (Time%25)=1
value = S21,(Random%6)
volumescale = 255

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=2
trigger1 = Time>=0 && (Time%25)=1
value = S22,(Random%6)
volumescale = 255

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=3
trigger1 = Time>=0 && (Time%25)=1
value = S23,(Random%6)
volumescale = 255

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=4
trigger1 = Time>=0 && (Time%25)=1
value = S24,(Random%6)
volumescale = 255

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=5
trigger1 = Time>=0 && (Time%25)=1
value = S25,(Random%5)
volumescale = 255

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=6
trigger1 = Time>=0 && (Time%25)=1
value = S26,(Random%4)
volumescale = 255

[State 20, Snd]
type = PlaySnd
triggerall = !IsHelper
triggerall = Var(22)=7
trigger1 = Time>=0 && (Time%25)=1
value = S27,(Random%6)
volumescale = 255

[state 20]
type = SelfState
triggerall = !IsHelper
triggerall = !Var(59)
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
value = 0
ctrl = 1

[State 20]
type = SelfState
triggerall = !IsHelper
triggerall = Var(59)
trigger1 = P2BodyDist X <= 10
trigger2 = FrontEdgeBodyDist <= 10
trigger3 = Roundstate != 2
trigger4 = Time >= 12+Random%23
trigger4 = InGuardDist
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Jump Start
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0

[State 40, Jump Direction]
type = VarSet
triggerall = !IsHelper
trigger1 = !Var(59)
sysvar(1) = IfElse(!Time,0,IfElse(Command="holdfwd",1,IfElse(Command="holdback",-1,SysVar(1))))

[State 40, AI Jump Direction]
type = VarSet
triggerall = !IsHelper
trigger1 = Var(59)
sysvar(1) = IfElse((EnemyNear,MoveType!=A || BackEdgeBodyDist<=10),1,IfElse((EnemyNear,Movetype=A),-1,0))

[State 40, Var]
type = VarSet
triggerall = !IsHelper
trigger1 = !Var(59) && !Time
sysvar(2) = 0

[State 40, Var]
type = VarSet
triggerall = !IsHelper
trigger1 = !Var(59)
trigger1 = Command="SuperJump" || Command="SuperJumpF" || Command="SuperJumpB"
sysvar(2) = 1

[State 40, Turn]
type = Turn
triggerall = !IsHelper
trigger1 = !Time && P2Dist X < 0

[State 40, Snd]
type = PlaySnd
triggerall = !IsHelper
trigger1 = !Time
value = S40,(Random%4)
volumescale = 255

[State 40, Dust]
type = Explod
triggerall = PlayerIDExist(ID)
triggerall = !IsHelper
trigger1 = !Time
anim = 6300
pos = 0,3
postype = p1
scale = 0.3,0.3
facing = 1
bindtime = 1
removetime = -2
sprpriority = 3
ownpal = 1
trans = Add
removeongethit = 1
ignorehitpause = 1

[State 40, AfterImage]
type = AfterImage
triggerall = !IsHelper
trigger1 = SysVar(2)
trigger1 = !AnimTime
time = 11
length = 5
palbright = 40,40,40
palcontrast = 250,250,250
palpostbright = 0,0,0
timegap = 1
trans = Add1

[State 40, Vel]
type = VelSet
triggerall = !IsHelper
trigger1 = !AnimTime
x = Cond(SysVar(1)=0,Const(Velocity.Jump.Neu.X),Cond(SysVar(1)=1,Const(Velocity.Jump.Fwd.X),Const(Velocity.Jump.Back.X)))*IfElse(SysVar(2),1.40,1)
y = Const(Velocity.Jump.Y)*IfElse(SysVar(2),1.14,1)

[State 40, Vel]
type = VelSet
triggerall = !IsHelper
trigger1 = !AnimTime
trigger1 = PrevStateNo = 100
trigger1 = SysVar(1) = 1
x = Const(Velocity.RunJump.Fwd.X)

[State 40, Self]
type = SelfState
triggerall = !IsHelper
trigger1 = !AnimTime
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;Air Jump
[Statedef 45]
type = A
physics = N
ctrl = 0
velset = 0,0

[State 45, Snd]
type = PlaySnd
triggerall = !IsHelper
trigger1 = !Time
value = S40,(Random%4)
volumescale = 255

[State 45, Anim]
type = ChangeAnim
triggerall = !IsHelper
trigger1 = SelfAnimExist(44)
value = 44

[State 45, Anim]
type = ChangeAnim
triggerall = !IsHelper
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, AI]
type = VarSet
triggerall = !IsHelper
trigger1 = Var(59)
sysvar(1) = IfElse((EnemyNear,MoveType!=A || BackEdgeBodyDist<=10),1,IfElse((EnemyNear,MoveType=A),-1,0))

[State 45, Var]
type = VarSet
triggerall = !IsHelper
trigger1 = !Var(59)
sysvar(1) = IfElse(!Time,0,IfElse(Command="holdfwd",1,IfElse(Command="holdback",-1,SysVar(1))))

[State 45, Vel]
type = VelSet
triggerall = !IsHelper
trigger1 = Time = 2
x = Cond(SysVar(1)=0,Const(Velocity.AirJump.Neu.X),Cond(SysVar(1)=1,Const(Velocity.AirJump.Fwd.X),Const(Velocity.AirJump.Back.X)))
y = Const(Velocity.AirJump.Y)

[State 45, Self]
type = SelfState
triggerall = !IsHelper
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;Jump Up
[Statedef 50]
type = A
physics = A
anim = IfElse((Vel X)=0,41,IfElse((Vel X)>0,42,43))

[State 50, Var]
type = VarSet
triggerall = !IsHelper
trigger1 = !Time
sysvar(1) = 0

[State 50, Snd]
type = PlaySnd
triggerall = !IsHelper
trigger1 = PrevStateNo = 60
trigger1 = !Time
value = S40,(Random%4)
volumescale = 255

[State 50, Anim]
type = ChangeAnim
triggerall = !IsHelper
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(Anim+3)
value = Anim+3
persistent = 0

[State 50, Transition]
type = PosAdd
triggerall = !IsHelper
trigger1 = Vel Y > 0
x = Vel X
persistent = 0

;---------------------------------------------------------------------------
;Jump Down (empty state for compatibility)
[Statedef 51]
type = A
physics = A

[State 51, Null]
type = Null
trigger1 = 1

