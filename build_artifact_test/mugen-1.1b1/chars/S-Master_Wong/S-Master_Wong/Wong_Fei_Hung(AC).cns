[State 5110, 1];For hit up/up-diag type (from state 5081)
type = ChangeAnim
trigger1 = SelfAnimExist(5110 + (anim % 10))
trigger1 = anim = [5081,5089]
value = 5110 + (anim % 10)
persistent = 0
ignorehitpause = 1

[State 5110, 2];Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170
ignorehitpause = 1

[State 5110, 3];Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim = [5161,5169]
trigger1 = SelfAnimExist(5170 + (anim % 10))
value = 5170 + (anim % 10)
ignorehitpause = 1

[State 5110, Var];Get fall velocity
type = VarSet
trigger1 = time = 0
trigger1 = gethitvar(fall.yvel) != 0
sysvar(1) = floor(vel y)
ignorehitpause = 1

[State 5110, 9] ;For hit up type
type = ChangeAnim
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = animtime = 0
trigger2 = sysvar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5110 + (anim % 10)
persistent = 0
ignorehitpause = 1

[State 5110, 10] ;For normal
type = ChangeAnim
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110
persistent = 0
ignorehitpause = 1

[State 5110, 11];If just died
type = ChangeState
triggerall = !alive
trigger1 = animtime = 0
trigger2 = sysvar(0)
trigger3 = anim = [5110,5119]
value = 5150
ctrl = 0
ignorehitpause = 1

[State 5110, 12]
type = VarSet
trigger1 = sysvar(0)
trigger1 = time = 0
sysvar(0) = 0
ignorehitpause = 1

[State 5111,A]
type = VarSet
trigger1 = time = 0
sysvar(2) = 0
ignorehitpause = 1

[State 5111,B]
type = VarAdd
trigger1 = sysvar(2) <= const(data.liedown.time)
sysvar(2) = 1

[State 5110, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5105,無敵なし]
type = HitBy
trigger1 = sysfvar(2) = 33
trigger1 = sysvar(2) <= floor(0.6*(const(data.liedown.time)))
value = SCA,AA,AP,AT
ignorehitpause = 1

[State 5105,無敵]
type = NotHitBy
trigger1 = sysfvar(2) != 33
trigger2 = sysfvar(2) = 33
trigger2 = sysvar(2) > floor(0.6*(const(data.liedown.time)))
value = SCA,AA,AP,AT
ignorehitpause = 1

[State 5111,ステート変更]
type = ChangeState
triggerall = alive
trigger1 = sysvar(2) > const(data.liedown.time)
value = 5120
ctrl = 0
;---------------------------------------------------------------------------
