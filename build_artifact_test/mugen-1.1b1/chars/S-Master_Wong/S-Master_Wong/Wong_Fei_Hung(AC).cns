;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;黄飛鴻(AC)_改変版
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;基本データ部分
[Data]
life              = 1000  ;体力ゲージの最大値を決めます
power             = 30000 ;パワーゲージ最大値(オプション)
attack            = 100   ;攻撃力パーセンテージ
defence           = 100   ;防御力パーセンテージ
fall.defence_up   = 50    ;一時的に上昇するダウン時の防御力パーセンテージ
liedown.time      = 60    ;倒れてから起き上がるまでの時間
airjuggle         = 999999;ジャグルポイント限界値
sparkno           = 2     ;デフォルトのヒットスパーク番号(fightfx.airか、キャラのairから呼び出す)
guard.sparkno     = 40    ;デフォルトのガードスパーク番号(fightfx.airか、キャラのairから呼び出す)
ko.echo           = 0     ;K.O.時の声にエコーを掛けるかどうか(0=しない・1=する)
volume            = 255   ;キャラの音量(255が最高)
intpersistindex   = 59    ; varを次のラウンドへ持ち越しが可能(最小=0, 最大=59)
floatpersistindex = 39    ;fvarを次のラウンドへ持ち越しが可能(最小=0, 最大=39)
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;サイズ設定
[Size]
xscale           = 0.75   ;キャラ画像の横のスケール
yscale           = 1.00   ;キャラ画像の縦のスケール
ground.back      = 40     ;キャラの幅(地上後方)
ground.front     = 20     ;キャラの幅(地上前方)
air.back         = 25     ;キャラの幅(空中後方)
air.front        = 20     ;キャラの幅(空中前方)
height           = 60     ;跳び越す相手のためのキャラの高さ
attack.dist      = 0      ;攻撃を出した時に相手がガード体勢に入る最低の距離
proj.attack.dist = 0      ;相手がガード体勢に入る発射物との最低の距離
proj.doscale     = 1      ;xscaleとyscaleが発射物のスケールにも影響するかどうか(0=しない・1=する)
head.pos         = -10,-90;BindToTargetの時に必要な頭の座標
mid.pos          = -10,-40;BindToTargetの時に必要な体中心の座標
shadowoffset     = 0      ;影の垂直方向の位置
draw.offset      = 0,0    ;キャラ描画表示位置(X軸,Y軸)
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;移動速度設定
[Velocity]
walk.fwd     = 2.5  ;前進歩行速度
walk.back    = -2.5 ;後退歩行速度
run.fwd      = 9,0  ;前に走る時の速度(X軸,Y軸）
run.back     = -9,0 ;後ろに走る時の速度(X軸,Y軸）
jump.neu     = 0,-10;垂直ジャンプ速度(X軸,Y軸）
jump.fwd     = 3.34 ;前ジャンプ速度
jump.back    = -3.34;後ジャンプ速度
runjump.fwd  = 4.5  ;前に走りながらのジャンプ速度（オプション）
runjump.back = -4.5 ;後ろに走りながらのジャンプ速度（オプション）
airjump.neu  = 0,-10;空中垂直ジャンプ速度（オプション）
airjump.fwd  = 3.34 ;空中前ジャンプ速度（オプション）
airjump.back = -3.34;空中後ジャンプ速度（オプション）
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;動作設定
[Movement]
airjump.num     = 0   ;空中ジャンプが出来る回数（オプション）
airjump.height  = 40  ;空中ジャンプするために必要な最低限の高さ（オプション）
yaccel          = 0.47;重力（垂直下降加速度）
stand.friction  = 0.9 ;立ち状態の摩擦係数
crouch.friction = 0.82;しゃがみ状態の摩擦係数
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;---------------------------------------------------------------------------
; 勝利ポーズ分岐
[Statedef 180]
type = S
movetype = I
physics = N
ctrl = 0
anim = 180
velset = 0,0
poweradd = 0
sprpriority = 2

[State -2,life]
type = VarSet
triggerall = !ishelper
trigger1 = time = 0
sysvar(4) = life
ignorehitpause = 1

[State 180]
type = AssertSpecial
trigger1 = 1
flag = roundnotover
ignorehitpause = 1

[State 180,負け]
type = ChangeState
triggerall = animtime = 0
trigger1 = lose
value = 170
ctrl = 0

[State 180,引き分け]
type = ChangeState
triggerall = animtime = 0
trigger1 = drawgame
value = 175
ctrl = 0

[State 180,勝ち]
type = ChangeState
triggerall = animtime = 0
trigger1 = wintime
value = 182
ctrl = 0

[State 180,勝利ポーズ]
type = ChangeState
triggerall = animtime = 0
trigger1 = matchover = 0
trigger1 = !wintime
value = 181
ctrl = 0

[State 180,勝利ポーズ1]
type = ChangeState
triggerall = animtime = 0
trigger1 = matchover = 1
trigger1 = !wintime
value = ifelse(random<=450,181,183)
ctrl = 0
