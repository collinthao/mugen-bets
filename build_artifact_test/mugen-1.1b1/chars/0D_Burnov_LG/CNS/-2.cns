;入力---------------------


[State -1, リセット時間]
type = varadd
triggerall = roundstate = 2
trigger1 = var(8)
var(8) = 1
Persistent = 1


[State -1, 先行入力リセット]
type = varset
trigger1 = roundstate != 2
trigger2 = var(8) < 0
Trigger3 = (var(8) = [20000,399999])&&movetype = A&&time = 1
Trigger4 = ((stateno = [900,929])||(stateno = [1000,2999]))&&time >= 3
trigger5 = statetype != L&&statetype != A
trigger5 = floor(var(8)%100) = 15
trigger6 = statetype = L||statetype = A
trigger6 = floor(var(8)%100) = 25
Trigger7 = stateno = 1305 
var(8) = 0
Persistent = 1

;******************補正合計******************************************************

;---------------補正合計----------------------------------------

[State -2, アタック]
type = AttackMulSet
trigger1 = roundstate = 2
value = Helper(10010+id),fVar(24)
ignorehitpause = 1

[State -2, ディフェンス]
type = DefenceMulSet
trigger1 = roundstate = 2
trigger1 = Helper(10010+id),fVar(20)
value = 1/Helper(10010+id),fVar(20)
ignorehitpause = 1

[State -2, 初撃防御力ヒット確認リセット]
type = VarSet
triggerall = !IsHelper
trigger1 = MoveType != H
trigger2 = StateNo = [120, 159]
trigger3 = StateNo = 771
trigger4 = (Life <= 100)
v = 33
value = 0
ignorehitpause = 1

[State -2, 初撃防御力ヒット確認]
type = VarSet
triggerall = (Life > 100)
triggerall = !IsHelper
trigger1 = MoveType = H
trigger1 = StateNo != [120, 159]
trigger1 = StateNo != 771
v = 33
value = GetHitVar(HitCount)
ignorehitpause = 1

[State -2, 初撃防御力]
type           = LifeAdd
triggerall = (Life > 100)
triggerall     = Alive
triggerall     = life - var(35) > 0
triggerall = StateNo != 771
triggerall     = var(33) = 1
triggerall     = var(34) := GetHitVar(Damage)
trigger1       = var(35) := Floor(var(34) * (1.0 - ((Const(data.defence) / Helper(10010+id),fvar(20)) / 100)))
value          = var(35)
absolute       = 1
persistent     = 0
ignorehitpause = 1

[State -2, 初撃防御力KO]
type           = LifeAdd
triggerall = (Life > 100)
triggerall     = var(33) = 1
triggerall     = Alive
trigger1     = life - var(35) <= 0
value          = -1
absolute       = 1
persistent     = 0
ignorehitpause = 1
;******************補正合計******************************************************

;******************パレット・残像消去******************************************************
[State -2, 残像]
type = AfterImage
trigger1 = StateNo = 0
trigger2 = StateNo = 52
trigger3 = StateNo = [5000,5210]
trigger4 = ctrl = 1
Time = 0

;******************パレット・残像消去******************************************************


;******************ヘルパー******************************************************

[State -2, 音を鳴らす]
type = PlaySnd
trigger1 = NumTarget(800) >= 1
trigger1 = target(800),Stateno = 816
trigger1 = target(800),Vel Y > 0&&target(800),Pos Y >= 0
value = 1, 2
ignorehitpause = 1

