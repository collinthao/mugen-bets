triggerall = frontEdgeBodyDist <= 240
triggerall = EnemyNear(var(30)),backEdgeBodyDist <= 30
triggerall = var(4)
trigger1 = stateno = [1100,1199]
trigger1 = movetype = A
trigger1 = time = 1
x = -var(4)
IgnoreHitPause = 1

[State -2, ヘルパーヒット時画面端押し戻し]
type = velset
triggerall = statetype != A
triggerall = frontEdgeBodyDist <= 90
triggerall = EnemyNear(var(30)),backEdgeBodyDist <= 10
triggerall = var(12) = 1
trigger1 = anim = 1100||anim = 1101
x = -6+var(12)
ignorehitpause = 1
Persistent = 1

[state -2, ヘルパー画面端ヒット減少]
type = Varadd
trigger1 = var(12)
var(12) = -1
ignorehitpause = 1
Persistent = 1

[state -2, ヘルパー画面端ヒットリセット]
type = Varset
trigger1 = var(12) < 0
var(12) = 0
ignorehitpause = 1
Persistent = 1


[State -3, システムヘルパー]
