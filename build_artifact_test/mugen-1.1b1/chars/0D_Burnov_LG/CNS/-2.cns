;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------

;デバッグモードに白い文字の表示を加える
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "1=%d,V50=%d,V1-J=%d,V24-D=%f,Var14-B=%d"
params = Helper(10010+id),var(13) ,var(9),Helper(10010+id),Var(3),Helper(10010+id),fVar(24),Helper(10010+id),Var(14)
ignorehitpause = 1

;表示を横に加える
[State -2, デバッグ表示その2]
type = AppendToClipboard
trigger1 = 1
text = " V13-A=%d,V21-R=%d,Pos X=%d,Y=%d"
params = var(13),var(21),ceil(Pos X),PrevStateNo
ignorehitpause = 1

;表示を下に加える
[State -2, デバッグ表示その3]
type = AppendToClipboard
trigger1 = 1
text = "\nDist X=%d,Y=%d, Vel X=%d/10,Y=%d/10 : Power=%d"
params = floor(P2BodyDist X),ceil(P2BodyDist Y),ceil(Vel X*10),floor(Vel Y*10),Power
ignorehitpause = 1

; 1,1以降ワイド画面自動切り替え
[State 5900, 1]
type = VarSet
trigger1 = var(2) = 2
trigger1 = 2**9 = 4096
var(2) = 0
;winmugen通常画面比率

; 1,1以降ワイド画面自動切り替え
[State 5900, 1]
type = VarSet
trigger1 = var(2) = 2
trigger1 = 2**9 != 4096
var(2) = 1
;mugen1.1ワイド画面比率



[state -2, キャンセルダウン]
