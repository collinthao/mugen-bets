[State -1, 空中ヘビークラッシュ暗転]
type = ChangeState
value = 2151
triggerall = !IsHelper
triggerall = var(59) != 1
triggerall = movetype != H
triggerall = (command = "→↓←→y"||var(8) = [210100,200099])
triggerall = statetype = A
triggerall = power >= 1000
trigger1 = ctrl||((stateno = [200,699])&&time <= 5)
trigger2 = (stateno = [600,699])
trigger2 = movecontact
trigger3 = (stateno = [1000,1099])
trigger3 = movehit

