
;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------通常攻撃---------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

; 立ち弱パンチ

[Statedef 200]
type     = S
movetype = A
physics  = S
juggle   = 1
ctrl     = 0
anim     = 200
sprpriority = 1

[State , 振り音]
type = PlaySnd
trigger1 = animelem = 2
value = 0, 0

;*********************************************
[state -2, エフェクトX軸]
type = Varset
trigger1 = time = 0
var(15) = ceil(0*const(size.xscale))
ignorehitpause = 1

[state -2, エフェクトY軸]
type = Varset
trigger1 = time = 0
var(16) = ceil(-80*const(size.yscale))
ignorehitpause = 1
;*********************************************

[State 200, 弱ヒット定義];空中ガードなし
type = HitDef 
trigger1 = Time = 0
;攻撃属性
attr = S, NA
guardflag = M
ground.type = H
;アニメ属性
animtype  = L
;ダメージ　ポーズ
damage    = 40
pausetime = 10 + var(39),10 + var(39)
;
sparkno = -1
guard.sparkno = -1
sparkxy =0,0
hitsound   = -1
guardsound = -1
;ヒットタイム
ground.hittime  = var(36)
Guard.HitTime = var(37)
guard.ctrltime = var(37)
air.hittime = var(38)
ground.slidetime = var(36)-2
Guard.slidetime = var(36)-2
;ベクトル
ground.velocity = -6
air.velocity = -2,-4
air.cornerpush.veloff = -20
Priority = 4,H
getpower = 20
givepower = 5

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; 立ち強パンチ
[Statedef 210]
type     = S
movetype = A
physics  = S
juggle   = 1
poweradd = 0
ctrl     = 0
anim     = 210
sprpriority = 1

[State 1000, 空キャン受付終了後パワー]
type = PowerAdd
trigger1 = time = 4
value = 40

[State -2, 声]
type = PlaySnd
trigger1 = time = 4
value = 6,0
channel = 0

[State 40, 3]
type = ChangeAnim
trigger1 =p2bodydist X < 15
trigger1 = Time = 0
value = 211

[State 40, 3]
type = ChangeAnim
trigger1 =p2bodydist X >= 15
trigger1 = Time = 0
value = 210

[State , 振り音]
type = PlaySnd
trigger1 = animelem = 3
value = 0, 2

;*********************************************
[state -2, エフェクトX軸]
type = Varset
trigger1 = time = 0
var(15) = ceil(0*const(size.xscale))
ignorehitpause = 1

[state -2, エフェクトY軸]
type = Varset
trigger1 = time = 0
var(16) = ceil(-80*const(size.yscale))
ignorehitpause = 1

;*********************************************

[State 200, 弱ヒット定義];空中ガードなし
type = HitDef 
trigger1 = Time = 0
;攻撃属性
attr = S, NA
guardflag = M
ground.type = H
;アニメ属性
animtype  = H
;ダメージ　ポーズ
damage    = 80
pausetime = 10 + var(39),10 + var(39)
;
sparkno = -1
guard.sparkno = -1
sparkxy =0,0
hitsound   = -1
guardsound = -1
;ヒットタイム
ground.hittime  = var(36)
Guard.HitTime = var(37)
guard.ctrltime = var(37)
air.hittime = var(38)
ground.slidetime = var(36)-2
Guard.slidetime = var(36)-2
;ベクトル
ground.velocity = -14
air.velocity = -6,-4
air.cornerpush.veloff = -20
Priority = 4,H
getpower = 80
givepower = 20

[State 3000,ヒット時背景変色]
type = BGPalfx
trigger1 = movehit = 1
add = 56,56,56
time = 2
IgNoreHitPause = 1
Persistent = 30



[State 210, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

