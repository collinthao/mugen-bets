;******************************************************************
;倒地追撃(飛ぶ)
[Statedef 350]
type    = A
movetype= A
physics = N
juggle  = 0
poweradd = 50
ctrl = 0
anim = 350
sprpriority = 2

[State 700, 声(逃がさん)]
type = PlaySnd
trigger1 = animelem = 1
value = 6, 0
channel = 0

[State 700,]
type = VelSet
trigger1 =(AnimElemTime(1) = 0)
x = 4

[State 700,]
type = VelSet
trigger1 =(AnimElemTime(2) >= 0)
x = P2BodyDist X/4

[State 700]
type = Velset
trigger1 =(AnimElemTime(1) = 0)
y= -12

[State 700]
type = Velset
trigger1 =vel x > 10
x= 10

[State 700]
type = Veladd
trigger1 =(AnimElemTime(4) >= 0)
trigger1 =P2BodyDist y > 0
y = P2BodyDist y/35

[State 700]
type = Veladd
trigger1 =(AnimElemTime(3) >= 0)
trigger1 =P2BodyDist y <= 0
y = 20

[State 701, ヒット定義]
type = HitDef
trigger1 = time = 0
attr = A, NT
hitflag = AFD+
priority = 1, Miss
sparkno = -1
p1sprpriority = 1
p2sprpriority = 0
p1stateno = 351
p2stateno = 355
pausetime = 1, 1
guard.dist = 0
fall = 1
down.bounce = 1
id = 800
getpower = 0
givepower = 20

[State 700, 着地へ]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 10
value = 52

:=================投げ==============================================
;---------------------------------------------------------------------------
;投げ 自分
[Statedef 351]
type     = S
movetype = A
physics  = N
anim     = 351
velset = 0,0
ctrl = 0

[State 800,***]
type = posset
trigger1 = time = 0
y = 0

[State 800,***]
type = TargetState
trigger1 = time = 0
trigger2 =AnimElem = 1
value = 355
ctrl = 0

[State 800,***]
type = TargetState
trigger1 = animelem = 2
value = 356

[State 3000, 位置]
type = Width
trigger1 = time = 0
value = 64,64

[State 3000, 掴んだ相手の位置]
type = TargetBind
trigger1 =  AnimElem = 1
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = P1

[State 3000, 3]
type = EnvShake
trigger1 =AnimElem = 1
time = 20
freq = 60
ampl = -4
phase = 120

[State 810, 掴んだ相手の体力ゲージの増減]
type = TargetLifeAdd
trigger1 =AnimElem = 1
value = Ceil(-80*Helper(10010+id),fVar(24)*(const(data.attack)*0.01))

[State -2,ヒットエフェクト]
type = Explod
trigger1 =  AnimElem = 6
anim = 30002
id = 30002
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = P1
sprpriority = -2
bindtime = 1
ownpal = 1
facing = 1
scale = 2*const(size.xscale),0.75*const(size.yscale)
ignorehitpause = 1
pausemovetime = ifelse(fvar(2),999999,0)
Persistent = 1

[State 600, 音を鳴らす]
type = PlaySnd
trigger1 =AnimElem = 1
value = 1, 3

[state 3];属性変更
type = StatetypeSet
triggerall = statetype != A
trigger1 = Animelem = 3
value = A

[State 4];速度を与える
type = VelSet
trigger1 = Animelem = 3
x = -5
y = -6

[State 5];空中になるので、重力を与える
type = gravity
triggerall = statetype = A
trigger1 = Animelem = 3,>= 0


[State 7];着地stateに移行
type = ChangeState
triggerall = statetype = A
trigger1 = Animelem = 3,>= 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 52

;---------------------------------------------------------------------------
;相手側の投げられモーション1
[Statedef 355]
type     = A
movetype = H
velset   = 0,0

[State 806, 制御した相手のアニメ変更]
type = ChangeAnim2
Trigger1 = time = 0
value = 355

[State 10000, 画面]
type = ScreenBound
trigger1 = 1
movecamera = 0,0
;---------------------------------------------------------------------------
; 吹っ飛び後地面に激突
[Statedef 356]
type    = L
movetype= H
physics = N

[State 5100, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 1]
type = VelSet
trigger1 = Time = 0
x = -0.5
y = -1

[State 5100, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5100, 2] ;Hit ground anim (normal)
type = ChangeAnim
trigger1 = time = 0
value = 5100

[State 5100, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 7]
type = selfState
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
value = 5110 ;HIT_LIEDOWN

[State 5100, 11]
type = PosFreeze
trigger1 = 1

[State 5100, 12]
type = selfState
trigger1 = AnimTime = 0
value = 5101
