;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State 183, 1]
type = AssertSpecial
triggerall = 1
triggerall = p2life<=2
trigger1 = stateno = [600,1100]
trigger2 = Var(26)>=1
trigger3 = Var(27)>=1
trigger4 = Var(28)>=1
trigger5 = Var(29)>=1
flag = timerfreeze
ignorehitpause = 1

[State 0, 1]
type = ChangeAnim
trigger1 = stateno = [123456,123458]
trigger1 = anim != 5400
trigger1 = 1
value = 5400

[State -2, Guarding]
type = AssertSpecial
trigger1 = 1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
ignorehitpause = 1

[State -2, NO SLOW]
type = AssertSpecial
trigger1 = 1
ignorehitpause = 1
flag = nokoslow
ignorehitpause = 1

[State -2, VAR]
type = AssertSpecial
triggerall = 1
triggerall = p2life<=2
trigger1 = stateno = [600,1100]
trigger2 = Var(26)>=1
trigger3 = Var(27)>=1
trigger4 = Var(28)>=1
trigger5 = Var(29)>=1
flag = Nomusic
ignorehitpause = 1

[State -2, VAR]
type = AssertSpecial
triggerall = 1
triggerall = p2life<=2
trigger1 = stateno = [600,1100]
trigger2 = Var(26)>=1
trigger3 = Var(27)>=1
trigger4 = Var(28)>=1
trigger5 = Var(29)>=1
flag = NoBarDisplay
ignorehitpause = 1

[State -2]
type = NotHitBy
trigger1 = 1
trigger1 = p2name != "GORO"
trigger1 = p2name != "MOTARO"
trigger1 = p2name != "KINTARO"
trigger1 = p2name != "SHAO KAHN"
value = ,NT,ST,HT
time = -1
Ignorehitpause = 1

[State 6, 2]
type = PlayerPush
trigger1 = 1
value = 1
Ignorehitpause = 1

