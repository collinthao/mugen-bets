value = 302
elem = AnimElemNo(0)

[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time%60 = 0
value = S358,2

[State 0, VelSet]
