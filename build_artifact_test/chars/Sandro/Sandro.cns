trigger1 = 1
x = 2+2*(Parent,Var(2) > 0)

[State 200, 3]
type = ChangeState
trigger1 = P2Dist X < 0
value = 301

[State 200, 3]
type = ChangeState
trigger1 = P2Dist X = [-10,50]
value = 303

