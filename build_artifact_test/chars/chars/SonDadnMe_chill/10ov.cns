;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
triggerall = time <= 0
trigger1 = roundno <= 1
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
triggerall = time <= 0
trigger1 = roundno <= 1
trigger1 = roundsexisted = 0
fvalue = 0

[State 0, RemapPal]
type = RemapPal
trigger1 = time <= 0
source = 1,palno
dest = 1,palno

;-----------------------------------------------------------------------------------;
[State Gonna stay like that.] 
type = ChangeState
triggerall = time >= 2
trigger1 = roundno >= 2
value = 0

[State Intro 1]
type = ChangeState
trigger1 = time >= 2
value = 190

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State 0, AI LEVEL 1.0]
type = VarSet
trigger1 = AILEVEL
v = 59
value = AILEVEL
[State 0, AI LEVEL 1.0]
type = VarSet
trigger1 = !AILEVEL
v = 59
value = -1

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = var(7)<=0
trigger1 = (stateno != [3000,4999]) 
trigger1 = (stateno != [6000,99999])
id = 8890

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "var(59) AI on? = %d  p2dist x = %f p2dist y = %f"
params = Var(59),p2dist x,p2dist y

[State -1, AI Helper Check]
type = ChangeState
triggerall = roundno >= 1
triggerall = roundstate >= 0
trigger1 = IsHelper(9741)
value = 9741

[State -1, AI Helper Check 2]
type = ChangeState
triggerall = roundno >= 1
triggerall = roundstate >= 0
trigger1 = IsHelper(9742)
value = 9742

[State -1, Go]
type = DestroySelf
triggerall = roundno >= 1
triggerall = roundstate >= 0
trigger1 = IsHelper
trigger1 = movereversed = 1


;------------------------
;Rage Meter
;------------------------
[State 0, VarAdd]
type = VarAdd
triggerall = var(7)>=1
trigger1 = time %1=0
v = 7
value = -1
ignorehitpause = -1

[State 0, VarAdd]
type = VarAdd
trigger1 = roundstate > 2
v = 7
value = -1
ignorehitpause = -1

[State 0, VarSet]
type = VarSet
trigger1 = roundstate = 3
v = 7
value = 0
ignorehitpause = -1

[State 0, AfterImage]
type = AfterImage
trigger1 = var(7)>=1
trigger1 = time %20=0
time = 20
length = 20
palcolor = 256
palbright = 30,30,30
palcontrast = 190,120,220
paladd = 18,10,25
timegap = 1
framegap = 4
trans = add
ignorehitpause = -1

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = numexplod(7)&&var(7)>0
ID = 7
pausemovetime = 9999
supermovetime = 9999
scale = 1+.102*var(7),1

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = var(7)<=0
ID = 7
removetime = 0
pausemovetime = 9999
supermovetime = 9999
scale = .001,.001

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = var(7)<=0
id = 10

[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = var(7)>=1
value = 2
[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = var(7)<=0
value = 1

[State 0, NotHitBy]
type = NotHitBy
trigger1 = var(7)>=1
value = SCA,AA,AP,AT
time = 2

[State 0, Explod]
type = Explod
trigger1 = Anim = 5150
trigger1 = AnimElem = 18
anim = 5151
ID = 5151
pos = 0,0
postype = p1
bindtime = -1
removetime = -2
scale = .7,.7
shadow = -1
ownpal = 1
SprPriority = 2
removeongethit = 1

[State 0, EnvShake]
type = EnvShake
trigger1 = Anim = 5150
trigger1 = AnimElem = 18
time = 35
freq = 60
ampl = -10
phase = 90

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Anim = 5150
trigger1 = AnimElem = 18
value = 5150,0