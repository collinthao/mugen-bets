[state ]
type=DestroySelf
trigger1=1

[State 910000, 操作不可]
type = CtrlSet
trigger1 = 1
value = 0
ignorehitpause = 1
[State 910000, すり抜け]
type = PlayerPush
trigger1 = 1
value = 0
ignorehitpause = 1
[State 910000, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1
[State 910000, カメラが追わないように]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0, 0
ignorehitpause = 1
[State 910000, 準ステート固定]
type = ChangeState
trigger1 = 1
value = 5150
persistent = 256
ignorehitpause = 1

;----------------------------------------------------------------------------
;(HELPER)AI起動兼敵攻撃ヘルパー感知ヘルパー2(このヘルパーのfvar(35)～fvar(39)は使わないで下さい、敵ヘルパー感知に使います)
[Statedef 77760]
type = A
ctrl = 0
velset = 0,0
movetype = A
physics = N
sprpriority = 0

[State 0, VarSet]
type = VarSet
trigger1 = ishelper
fv = 35
value = 140;←の数字は敵の攻撃ヘルパーが横からどこまで近くにいたら感知するのかを設定します、デフォルトでは140
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = ishelper
fv = 36
value = 30;←の数字は敵の攻撃ヘルパーが自分より下にいてどこまで近くにいたら感知するのかを設定します、デフォルトでは30
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = ishelper
fv = 37
value = 180;←の数字は敵の攻撃ヘルパーが自分より上にいてどこまで近くにいたら感知するのかを設定します、デフォルトでは180
ignorehitpause = 1

[State 11000, 間違いで本体が来たら立ちへ移行]
type = SelfState
trigger1 = !ishelper
value = IfElse(Pos Y = 0,0,5040)
ctrl = 1
ignorehitpause = 1

[State 0, ChangeAnim];これは相手の当身しにくいhitdefを判断する為のAnimです、絶対に消さないで下さい
type = ChangeAnim
trigger1 = 1
value = 76671;←76671には使われてないAnim番号を入れて下さい、66000とかはあまり被ってないかも？、入れるアニメはAnim.txtから拝借して下さい
ignorehitpause = 1

[State 11000, Turn]
type = Turn
trigger1 = facing != root,facing

[State 11000, AssertSpecial]
type = AssertSpecial
Trigger1 = 1
flag = NoShadow
flag2 = invisible
ignorehitpause = 1

[State 11000, NotHitBy]
type = NotHitBy
Trigger1 = 1
value = SCA;ここは相手の当身しにくいhitdefを判断する為絶対に変えないで下さい
ignorehitpause = 1

[STATE BtR]
type = PosSet
trigger1 = 1
x = Root,Pos x
y = Root,Pos y
ignorehitpause = 1

[State 0, 相手がガードしないように]
type = AttackDist
trigger1 = 1
value = 0
ignorehitpause = 1

;---------------------[敵ヘルパー当身しにくいhitdef認識]
[STATE ]
type = VarSet
trigger1 = 1
fvar(38) = 0

[STATE ]
type = VarSet
trigger1 = 1
fvar(39) = 0

