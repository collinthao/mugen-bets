[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47+(var(1)*(10000))
velset = 0,0
facep2 = 1
hitcountpersist = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(3) = 3
value = 52+(var(1)*(10000))

[State 52, pos]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, pos]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, snd]
type = PlaySnd
trigger1 = var(3) != 3
trigger1 = Time = 0
value = 0, 2; 着地音

[State 52, ctl]
type = CtrlSet
trigger1 = Time = 3
trigger1 = PrevStateNo != [1600,1650]
value = 1

[State 0, VarSet]
type = VarSet
trigger1 = Time >= 1
var(3) = 0

[State 52, e]
type = ChangeState
trigger1 = var(39) < 8
trigger1 = AnimTime = 0
trigger1 = PrevStateNo != [1600,1650]
trigger2 = Time = 8
trigger2 = PrevStateNo = [1600,1650]
trigger3 = var(39) >= 8
trigger3 = Time >= 4
trigger3 = PrevStateNo != [1600,1650]
value = 0
ctrl = 1

[State 死亡時]
type = ChangeState
triggerall = name = "DBS Broly Movie Goku English"
trigger1 = !alive
value = 5050
ignorehitpause = 1

