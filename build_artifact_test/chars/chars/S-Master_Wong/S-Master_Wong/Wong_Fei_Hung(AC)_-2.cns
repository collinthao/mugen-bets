;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;******************************************************************************
;------------------------------------------------------------------------------
;常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;------------------------------------------------------------------------------
[Statedef -2]
;******************************************************************************
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;(*´ω｀*)流
;(*´ω｀*)行
;(*´ω｀*)る
;------------------------------------------------------------------------------
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;******************************************************************************
;--------------------------↓Config↓------------------------------------------
;モード設定
[State -2,ModeSet]
type = VarSet
triggerall = !ishelper
trigger1 = !(var(0) = 1)
;                    ↑
;              この数値を変更(0-2)
;                    ↓
var(0) =              1
;0:弱化モード
;1:通常モード
;2:全開モード(通常モード+後のコンフィグを無視)
ignorehitpause = 1

;プレイヤー操作時
[State -2,ModeSet(PLAYER)]
type = Null
triggerall = !ishelper
triggerall = var(0) = [0,1]
triggerall = var(59) = 0
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓根性値有無↓
trigger1 = 1 || var(20):= 0;この数値を変更(0-1)
;0:無し
;1:有り
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓コントロール時のブロッキング性能↓
trigger1 = 1 || var(21):= 1;この数値を変更(0-1)
;0:コマンド仕込み時のみ
;1:常時仕込み状態
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓ブロッキング時の体力回復値↓
trigger1 = 1 || var(22):= 2;この数値を変更(0-2)
;0:回復なし
;1:50回復
;2:100回復
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓特殊超必殺技の有無/性能変更↓
trigger1 = 1 || var(23):= 2;この数値を変更(0-2)
;有無
;0    :無し(使用不可能)
;1以降:有り(使用可能)
;有る時の性能
;1:OthK無し
;2:OthK有り
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
ignorehitpause = 1

;AI時
[State -2,ModeSet(AI)]
type = Null
triggerall = !ishelper
triggerall = var(0) = [0,1]
triggerall = var(59) = [1,11]
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓根性値有無↓
trigger1 = 1 || var(20):= 0;この数値を変更(0-1)
;0:無し
;1:有り
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓コントロール時のブロッキング性能(AI)↓
trigger1 = 1 || var(21):= 1;この数値を変更(0-1)
;0:ランダム
;1:常時
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓ブロッキング時の体力回復値↓
trigger1 = 1 || var(22):= 2;この数値を変更(0-2)
;0:回復なし
;1:50回復
;2:100回復
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●↓特殊超必殺技の有無/性能変更↓
trigger1 = 1 || var(23):= 2;この数値を変更(0-2)
;有無
;0    :無し(使用不可能)
;1以降:有り(使用可能)
;有る時の性能
;1:OthK無し
;2:OthK有り
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●AIコンボ制限(現在肘永久のみ)
trigger1 = 1 || var(55):= 1;この数値を変更(0-1)
;0:途中でやめる(肘3hitまで)
;1:永久確定
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
;●AI力溜条件
trigger1 = 1 || var(56):= 1;この数値を変更(0-2)
;0:途中でやめる事あり
;1:最後まで溜めるかどうかは条件次第
;2:必ず最後まで溜める
;━━━━━━━━━━━━━━━━━━━━━━━━━━━
ignorehitpause = 1

;AIの通常食らい時閃躱使用率
[State -2,ModeSet]
type = Null
triggerall = !ishelper
triggerall = var(0) = [0,1]
trigger1 = var(59) = [1,3]
trigger1 = 1 || var(53):= 1000;地上版
trigger1 = 1 || var(54):= 1000;空中版
trigger2 = var(59) = [4,8]
trigger2 = 1 || var(53):= 790;地上版
trigger2 = 1 || var(54):= 790;空中版
trigger3 = var(59) = [9,10]
trigger3 = 1 || var(53):= 334;地上版
trigger3 = 1 || var(54):= 334;空中版
trigger4 = var(59) = 11
trigger4 = 1 || var(53):= 0;地上版
trigger4 = 1 || var(54):= 0;空中版
;0:常時使う
;1-999:使う
;1000:使わない
ignorehitpause = 1

;AIレベル
[State -2,AI-Level]
type = Null
triggerall = !ishelper
triggerall = var(0) = [0,1]
trigger1 = palno = 1
trigger1 = 1 || var(59):= 11;この数値を変更
trigger2 = palno = 2
trigger2 = 1 || var(59):= 2;この数値を変更
trigger3 = palno = 3
trigger3 = 1 || var(59):= 0;この数値を変更
trigger4 = palno = 4
trigger4 = 1 || var(59):= 4;この数値を変更
trigger5 = palno = 5
trigger5 = 1 || var(59):= 9;この数値を変更
trigger6 = palno = 6
trigger6 = 1 || var(59):= 6;この数値を変更
trigger7 = palno = 7
trigger7 = 1 || var(59):= 1;この数値を変更
trigger8 = palno = 8
trigger8 = 1 || var(59):= 8;この数値を変更
trigger9 = palno = 9
trigger9 = 1 || var(59):= 0;この数値を変更
trigger10= palno = 10
trigger10= 1 || var(59):= 10;この数値を変更
trigger11= palno = 11
trigger11= 1 || var(59):= 11;この数値を変更
trigger12= palno = 12
trigger12= 1 || var(59):= 11;この数値を変更
;0   :AIオフ(AI off):人操作可能
;1-11:AIオン(AI on) :人操作不可能
;最大11レベルまで
ignorehitpause = 1
