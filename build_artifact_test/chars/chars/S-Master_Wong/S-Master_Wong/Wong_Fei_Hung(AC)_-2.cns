trigger4 = 1 || var(53):= 0;地上版
trigger4 = 1 || var(54):= 0;空中版
;0:常時使う
;1-999:使う
;1000:使わない
ignorehitpause = 1

;AIレベル(全開モード)
[State -2,AI-Level]
type = Null
triggerall = !ishelper
triggerall = var(0) = 2
trigger1 = palno = 1
trigger1 = 1 || var(59):= 12;この数値を変更
trigger2 = palno = 2
trigger2 = 1 || var(59):= 12;この数値を変更
trigger3 = palno = 3
trigger3 = 1 || var(59):= 0;この数値を変更
trigger4 = palno = 4
trigger4 = 1 || var(59):= 12;この数値を変更
trigger5 = palno = 5
trigger5 = 1 || var(59):= 10;この数値を変更
trigger6 = palno = 6
trigger6 = 1 || var(59):= 11;この数値を変更
trigger7 = palno = 7
trigger7 = 1 || var(59):= 12;この数値を変更
trigger8 = palno = 8
trigger8 = 1 || var(59):= 12;この数値を変更
trigger9 = palno = 9
trigger9 = 1 || var(59):= 12;この数値を変更
trigger10= palno = 10
trigger10= 1 || var(59):= 12;この数値を変更
trigger11= palno = 11
trigger11= 1 || var(59):= 12;この数値を変更
trigger12= palno = 12
trigger12= 1 || var(59):= 12;この数値を変更
;0   :AIオフ(AI off):人操作可能
;1-12:AIオン(AI on) :人操作不可能
;隠しAIレベル解禁(12を入れると隠しAIレベルになります)
