;--------------------------↓根性値↓------------------------------------------
[State -2,根性値用]
type = VarSet
triggerall = !ishelper
triggerall = roundstate >= 2
triggerall = var(20) = 1
trigger1 = time = 0
trigger2 = movetype != H
var(15) = -life
ignorehitpause = 1

[State -2,一打目ダメージ軽減]
type = LifeAdd
triggerall = !ishelper
triggerall = roundstate >= 2
triggerall = var(20) = 1
triggerall = alive
triggerall = (life >= 0.011*lifemax)
trigger1 = movetype = H
trigger1 = life < var(15)
value = floor(((var(15)-life)*fvar(15))-0.4)
absolute = 1
ignorehitpause = 1

[State -2,ダメージ軽減]
type = DefenceMulSet
triggerall = !ishelper
triggerall = var(20) = 1
trigger1 = var(15) >= -lifemax
value = 1.0-fvar(15)
ignorehitpause = 1

[State -2,ダウン有効]
type = VarSet
triggerall = !ishelper
triggerall = var(20) = 1
trigger1 = statetype = L || stateno = 5070
trigger1 = var(15) = 0
var(15) = -1-lifemax
ignorehitpause = 1

[State -2,ダウン中ダメージ軽減]
type = DefenceMulSet
triggerall = !ishelper
triggerall = var(20) = 1
trigger1 = var(15) < -lifemax
value = (1.0-fvar(15))*const(data.fall.defence_mul)
ignorehitpause = 1

[State -2,一打終了]
type = VarSet
triggerall = !ishelper
triggerall = var(20) = 1
trigger1 = movetype = H
trigger1 = life <= var(15) && var(15)
var(15) = 0
ignorehitpause = 1

[State -2,ライフ]
type = VarSet
triggerall = !ishelper
triggerall = var(20) = 1
trigger1 = movetype = H
trigger1 = var(15) < 0 && var(15) > -1-lifeMax
var(15) = -var(15)
ignorehitpause = 1

[State -2,根性値補正(数値)]
type = VarSet
triggerall = !ishelper
trigger1 = var(20) = 1
fvar(15) = 0.150*(life <= 0.50*lifemax)+0.300*(life <= 0.3*lifemax)
ignorehitpause = 1
