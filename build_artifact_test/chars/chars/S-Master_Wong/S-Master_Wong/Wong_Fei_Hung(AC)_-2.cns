trigger1 = (var(53) = 1000 || var(54) = 1000)
trigger1 = 1 || var(51):= 1000
trigger1 = 1 || var(52):= 1000
trigger2 = (var(53) <= 0 || var(53) >= 1001) || (var(54) <= 0 || var(54) >= 1001)
trigger2 = 1 || var(51):= 0
trigger2 = 1 || var(52):= 0
ignorehitpause = 1

[State -2,AIの通常食らい時閃躱(ライフ依存)]
type = Null
triggerall = !ishelper
triggerall = (var(53) = [1,999]) || (var(54) = [1,999])
trigger1 = (100*life/const(data.life)) >= 79
trigger1 = 1 || var(51):= var(53)
trigger1 = 1 || var(52):= var(54)
trigger2 = (100*life/const(data.life)) = [46,79]
trigger2 = 1 || var(51):= ifelse((var(53)-150)<=1,1,(var(53)-150))
trigger2 = 1 || var(52):= ifelse((var(54)-150)<=1,1,(var(54)-150))
trigger3 = (100*life/const(data.life)) = [21,45]
trigger3 = 1 || var(51):= ifelse((var(53)-250)<=1,1,(var(53)-250))
trigger3 = 1 || var(52):= ifelse((var(54)-250)<=1,1,(var(54)-250))
trigger4 = (100*life/const(data.life)) <= 20
trigger4 = 1 || var(51):= ifelse((var(53)-350)<=1,1,(var(53)-350))
trigger4 = 1 || var(52):= ifelse((var(54)-350)<=1,1,(var(54)-350))
ignorehitpause = 1

