;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;******************************************************************************
;------------------------------------------------------------------------------
;常時監視ステート(p2statenoなどで相手に行動を制御された時は実行しない)
;------------------------------------------------------------------------------
[Statedef -3]
;******************************************************************************
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;(*´ω｀*)流
;(*´ω｀*)行
;(*´ω｀*)る
;------------------------------------------------------------------------------
[State -3,保険用gametime変数]
type = VarSet
triggerall = !ishelper
trigger1 = 1
sysfvar(3) = (gametime*gametime*4)+((60/gametime)*(gametime+36))*0.5
ignorehitpause = 1

[State -3,保険用gametime変数2]
type = VarSet
triggerall = !ishelper
trigger1 = 1
sysfvar(4) = (gametime*0.334)+sin(gametime*pi/180)+gametime*cos(gametime*pi/180)
ignorehitpause = 1

[State -3,1Fだけ]
type = NotHitBy
triggerall = !ishelper
triggerall = roundstate = 2
triggerall = var(13) = 0
triggerall = time = 0
trigger1 = stateno = 5000
trigger2 = stateno = 5010
value2 = SCA,AA,AP,AT
time = 1
ignorehitpause = 1

[State -3,無敵判別]
type = VarSet
triggerall = !ishelper
trigger1 = var(13) != 0
trigger1 = movetype != H
var(13) = 0
ignorehitpause = 1

[State -3,端フラグ_リセット]
type = VarSet
triggerall = !ishelper
triggerall = roundstate = [2,3]
triggerall = numenemy
triggerall = enemy,teammode = single || enemy,teammode = turns
trigger1 = p2bodydist x > 120
trigger2 = facing = enemy,facing
trigger3 = enemy,backedgebodydist != [-6,6]
var(32) = -1
ignorehitpause = 1

[State -3,端フラグ_セット]
type = VarSet
triggerall = !ishelper
triggerall = roundstate = [2,3]
triggerall = numenemy
triggerall = enemy,teammode = single || enemy,teammode = turns
trigger1 = p2bodydist x <= 120
trigger1 = facing != enemy,facing
trigger1 = enemy,backedgebodydist = [-6,6]
var(32) = 1
ignorehitpause = 1

[State -3,端フラグ(タッグ)_リセット]
type = VarSet
triggerall = !ishelper
triggerall = roundstate = 2
triggerall = numenemy >= 1
triggerall = enemy,teammode = simul
trigger1 = p2bodydist x > 120
trigger2 = facing = enemynear(var(30)),facing
trigger3 = enemynear(var(30)),backedgebodydist != [-4,6]
var(32) = -1
ignorehitpause = 1

[State -1,端フラグ(タッグ)_セット]
type = VarSet
triggerall = !ishelper
triggerall = roundstate = 2
triggerall = numenemy >= 1
triggerall = enemy,teammode = simul
trigger1 = p2bodydist x <= 120
trigger1 = facing != enemynear(var(30)),facing
trigger1 = enemynear(var(30)),backedgebodydist = [-4,6]
var(32) = 1
ignorehitpause = 1

[State -3,端フラグ_リセット]
type = VarSet
triggerall = !ishelper
trigger1 = roundstate = [0,1]
trigger2 = roundstate = 4
var(32) = 0
ignorehitpause = 1

[State -2,AI用]
type = VarSet
triggerall = !ishelper
triggerall = var(59) != 0
triggerall = roundstate = 2
triggerall = var(49) = -1
trigger1 = !(stateno = [0,12])
trigger1 = !(stateno = [1600,1760])
trigger2 = enemynear(var(30)),movetype != H
var(49) = 0
ignorehitpause = 1

;******************************************************************************
;※注意※(こちらにも書いておきます)
;******************************************************************************
;コンフィグはWong_Fei_Hung(AC)_-2.cns内にあります。Configで検索するとあります。
;また特殊超必殺技の有無で有りを選んだ時は開始イントロをカットしない様にお願いします。(!!!重要!!!)
;↑無しを選んでいる場合はカットしてもいいですが出来るだけしないで頂ける用お願いします。
;AIをオンにした時は上記の有無に関わらず開始イントロのカット禁止です。(勝利デモとかはカットしてもOK)
;このキャラは"改変可能"です！
;・更新状況
;2016 02/22:公開
;2016 02/24:更新_バグ取り他
;2016 03/03:更新_バグ取り他
;2016 03/19:更新_バグ取り他
;2016 03/20:更新_バグ取り他
;2016 03/25:更新_バグ取り他
;2016 03/27:更新_バグ取り他
;2016 03/32:更新_バグ取り他
;2016 04/03:更新_バグ取り他
;2016 04/05:更新_バグ取り他
;2016 04/06:更新_バグ取り他
;2016 04/10:更新_バグ取り,システム面一部変更
;2016 04/12:更新_AI微修正
;2016 04/17:更新_バグ取り他
;2016 04/24:更新_バグ取り,絶・超級亂拳演出変更
;2016 04/29:更新_バグ取り他
;2016 04/30:更新_バグ取り他
;2016 05/01:更新_バグ取り他
;2016 05/07:更新_バグ取り他
;2016 05/08:更新_バグ取り他,powerシステム変更
;
;・おススメ条件
;●プレイヤー操作で挑む(凶上位以下)
;  弱化モード、ブロッキング時の体力回復なし
;  コントロール時のブロッキング性能(AI)を0、AIレベル1-5推奨
;●対AI(凶中位以下)
;  弱化モード、ブロッキング時の体力回復なし
;  コントロール時のブロッキング性能(AI)を0、AIレベル1-8推奨
;●対AI(凶上位-狂下位)
;  弱化モード、ブロッキング時の体力回復なし
;  コントロール時のブロッキング性能(AI)を0、AIレベル5-10推奨
;●対AI(狂中位)
;  通常モード、ブロッキング時の体力回復なしor50回復
;  コントロール時のブロッキング性能(AI)を0、AIレベル6-11推奨
;●対AI(狂上位)
;  通常モード、ブロッキング時の体力50回復
;  コントロール時のブロッキング性能(AI)を1、AIレベル8-11推奨
;●対AI(最大ランク狂最上位以上)
;  通常or全開モード、、ブロッキング時の体力50or100回復
;  コントロール時のブロッキング性能(AI)を1、AIレベル10-11(全開なら10-12)推奨
;
