;===========================================================================
; 常時監視ステート（－２）
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
;---------------------------------------------------------------------------

[Statedef -2]

;-----------------------------------

[State -2];くらい時の残像消し
type = AfterImage
trigger1 = movetype = H
time = 0

[State -2];モード判別
type = VarSet
trigger1 = PalNo = [1,6]
fvar(21) = 1

[State -2];モード判別
type = VarSet
trigger1 = PalNo = [7,12]
fvar(21) = 1.3

[State -2];メタリン攻撃力
type = AttackMulSet
trigger1 = fvar(21) = 1.3
value = 1.2

[State -2];メタリン防御力
type = DefenceMulSet
trigger1 = fvar(21) = 1.3
value = 0.7

[State -2];フバーハ
type = VarAdd
trigger1 = 1
var(10) = 1

[State -2];フバーハ
type = NotHitBy
trigger1 = NumHelper(11410) = 1
value = ,AP

;-----------------------------------
;ホイミ、ベホマ関係
[State -2]
type = LifeAdd
trigger1 = var(5) = 1
value = 4
persistent = 0

[State -2]
type = LifeAdd
trigger1 = var(5) = 2
value = 8
persistent = 0

[State -2]
type = Explod
trigger1 = var(5) = 1 || var(5) = 2
anim = 1406
pos = 0,-30
random = 60,60
postype = p1
bindtime = 20
vel = 0,-0.5
scale = 0.5,0.5
sprpriority = 5
ontop = 1
removeongethit = 1
removetime = 50

;-----------------------------------
;パートナー判別ヘルパー
[State -2, 1191]
type = Helper
trigger1 = RoundState = 2
trigger1 = NumHelper(1191) = 0
helpertype = normal
ID = 1191
name = "sukuruto"
stateno = 1191
postype = p1
facing = 1
pos = 0, 0

;-----------------------------------
;スクルト関係
[State -2]
type = Explod
trigger1 = RoundState = 2
trigger1 = var(1) = 0
trigger1 = Facing = 1
trigger1 = PalNo = [1,6]
anim = 850
scale = 0.8,0.8
pos = 0,-60
postype = p1
sprpriority = 2
ownpal = 1
bindtime = 50
removetime = -2

[State -2]
type = Explod
trigger1 = RoundState = 2
trigger1 = var(1) = 0
trigger1 = Facing = 1
trigger1 = PalNo = [7,12]
anim = 852
scale = 0.8,0.8
pos = 0,-60
postype = p1
sprpriority = 2
ownpal = 1
bindtime = 50
removetime = -2

[State -2]
type = Explod
trigger1 = RoundState = 2
trigger1 = var(1) = 0
trigger1 = Facing = -1
trigger1 = PalNo = [1,6]
anim = 851
scale = 0.8,0.8
pos = 0,-60
postype = p1
sprpriority = 2
ownpal = 1
bindtime = 50
removetime = -2

[State -2]
type = Explod
trigger1 = RoundState = 2
trigger1 = var(1) = 0
trigger1 = Facing = -1
trigger1 = PalNo = [7,12]
anim = 853
scale = 0.8,0.8
pos = 0,-60
postype = p1
sprpriority = 2
ownpal = 1
bindtime = 50
removetime = -2

[State -2]
type = Palfx
trigger1 = RoundState = 2
trigger1 = var(2) = 0
add = -100,100,-100
sinadd = 10, 10, 10
time = 15

[State -2]
type = Palfx
trigger1 = RoundState = 2
trigger1 = var(2) = 16
add = -200,100,-200
sinadd = 10, 10, 10
time = 22

[State -2]
type = Palfx
trigger1 = RoundState = 2
trigger1 = var(2) = 39
add = 250,250,250
sinadd = 10, 10, 10
time = 5

[State -2]
type = DefenceMulSet
trigger1 = var(3) = 1
trigger1 = PalNo = [1,6]
value = .85

[State -2]
type = VarAdd
trigger1 = 1
var(1) = 1

[State -2]
type = VarAdd
trigger1 = 1
var(2) = 1

;-----------------------------------
;デバッグ用
[State -2]
type = DisplayToClipboard
trigger1 = 1
text = "PalNo=%d, Var(11)=%f, Var(1)=%d, Var(2)=%d, Var(3)=%d \n"
params = PalNo,var(11),var(1),var(2),var(3)

[State -2]
type = AppendToClipboard
trigger1 = 1
text = "Position X=%d,Y=%d, Velocity X=%f,Y=%f, RoundState=%d \n"
params = floor(Pos X),floor(Pos Y),(Vel X),(Vel Y),(RoundState)


;===========================================================================
; 準常時監視ステート（－３）
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;-----------------------------------
;着地時の音
[State -3]
type = PlaySnd
triggerall = Time = 1
trigger1 = fvar(21) = 1.3
trigger1 = stateno = 52
value = 40, 0

[State -3]
type = PlaySnd
triggerall = Time = 1
trigger1 = fvar(21) = 1
trigger1 = stateno = 52
value = 40, 1
volume = -100


