;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type = S
movetype = I
physics = S
velset = 0,0
poweradd = 0
sprpriority = 1

[State 0,Self]
type = SelfState
triggerall = !ishelper
triggerall = !(name = "Wong_Fei_Hung(AC)" && authorname = "AMASO")
trigger1 = 1 || time = 0
value = 0
ctrl = 1
ignorehitpause = 1

[State 0]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1

[State 0]
type = ChangeAnim
trigger1 = !(anim = 0) && !(anim = 5)
trigger2 = anim = 5 && animtime = 0
value = 0
ignorehitpause = 1

[State 0,1]
type = SprPriority
trigger1 = numpartner
value = ifelse(id<partner,id,1,-1)

[State 0,変数固定]
type = Null
triggerall = !ishelper
triggerall = (name = "Wong_Fei_Hung(AC)" && authorname = "AMASO")
triggerall = 1 || time = 0
trigger1 = 1 || var(2):= 0
trigger1 = 1 || var(3):= 0
trigger1 = 1 || var(4):= 0
trigger1 = 1 || var(7):= 0
trigger1 = 1 || var(16):= 0
trigger1 = 1 || var(17):= 0
ignorehitpause = 1

[State 0]
type = NotHitBy
triggerall = !ishelper
trigger1 = time = 0
value = SCA,AA,AP,AT
time = 1
ignorehitpause = 1

[State 0]
type = AssertSpecial
triggerall = !ishelper
triggerall = (name = "Wong_Fei_Hung(AC)" && authorname = "AMASO")
trigger1 = var(59) = 0
flag = nostandguard
flag2 = nocrouchguard
ignorehitpause = 1

[State 0]
type = AssertSpecial
triggerall = !ishelper
triggerall = (name = "Wong_Fei_Hung(AC)" && authorname = "AMASO")
trigger1 = var(59) != 0
flag = nostandguard
flag2 = nocrouchguard
flag3 = nowalk
ignorehitpause = 1

[State 0]
type = ChangeState
triggerall = !ishelper
triggerall = alive
trigger1 = roundstate = 3
value = 140
ctrl = 1

[State 0]
type = ChangeState
triggerall = !ishelper
triggerall = !alive
trigger1 = time > 0
value = 5050
ctrl = 0
