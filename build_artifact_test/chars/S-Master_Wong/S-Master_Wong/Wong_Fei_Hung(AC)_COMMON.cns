;HITL_SHAKE
[Statedef 5080]
type = L
movetype = H
physics = N
ctrl = 0
velset = 0,0
poweradd = 0
sprpriority = 1

[State 5080, 1] ;Set default anim
type = VarSet
trigger1 = time = 0
sysvar(2) = ifelse(gethitvar(yvel)=0,5080,5090)

[State 5080, 2]
type = VarAdd
trigger1 = time = 0
trigger1 = (anim = [5081,5089]) || (anim = [5111,5119])
trigger1 = selfanimexist(sysvar(2)+(anim%10))
sysvar(2) = anim % 10

[State 5080, 3] ;If 5090 doesn't exist, default to 5030
type = VarSet
trigger1 = time = 0
trigger1 = sysvar(2) = 5090
trigger1 = !selfanimexist(5090)
sysvar(2) = 5030

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

[State 5000,食らい確認用2]
type = VarAdd
triggerall = !ishelper
triggerall = var(13) != 0
trigger1 = time = 0
var(13) = 1
ignorehitpause = 1

[State 5000,食らい確認用]
