trigger1 = time = 1
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 5100, 11]
type = PosFreeze
trigger1 = 1

[State 5120]
type = HitBy
trigger1 = 1
value2 = SCA,AA,AP,AT
ignorehitpause = 1

[State 5100, 12]
type = ChangeState
trigger1 = animtime = 0
value = 5101
ctrl = 0
