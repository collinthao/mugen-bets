trigger1 = ishelper
ignorehitpause = 1

[State 22]
type = SprPriority
trigger1 = numpartner
value = ifelse(id<partner,id,1,-1)

[State 22]
type = VelSet
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"
trigger2 = var(59) > 0
trigger2 = roundstate = 2
trigger2 = p2bodydist x >= 55
x = 1.25
y = 0

[State 22,停止条件]
type = VelSet
triggerall = alive
trigger1 = var(59) = 0
trigger1 = command != "holdfwd"
trigger2 = var(59) > 0
trigger2 = roundstate = 2
trigger2 = p2bodydist x < 55
trigger3 = var(59) > 0
trigger3 = roundstate >= 3
x = 0
y = 0

[State 12]
type = HitBy
trigger1 = 1
value = SCA,AP
ignorehitpause = 1

[State 15, 4]
type = Changestate
trigger1 = var(59) = 0
trigger1 = command != "holddown"
value = 12
ctrl = 1

[State 20, 5]
type = ChangeState
trigger1 = vel x = 0
value = 11
ctrl = 1
