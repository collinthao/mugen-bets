;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

[State -2]
type = varset
trigger1 = statetype != A
trigger2 = movetype = H
var(11) = 1

[State -2]
type = varset
triggerall = var(15) != 0
trigger1 = p2movetype != H
var(15) = 0

[State -2]
type = varset
triggerall = var(40) != 0
trigger1 = p2movetype != H
trigger2 = stateno = [6060,6061]
var(40) = 0

[State -2]
type = powerset
trigger1 = roundstate <= 1  
value = 0

[State -2, Var]
type = varset
trigger1 = var(50) != 0
trigger1 = roundstate <= 1
var(50) = 0

;normal grab chain prevention
[State -2];;var(59)
type = varset
triggerall = var(58) = 0
trigger1 = enemynear,stateno = [5000,5011]
var(58) = 1

[State -2];;var(59)
type = varset
triggerall = var(58) != 0
trigger1 = enemynear,movetype != H
trigger1 = time%2 = 0
var(58) = 0

[State -2]
type = Explod
triggerall = TeamSide = 1
trigger1 = !NumHelper(2957)
trigger1 = var(50) = 0 
trigger1 = !MatchOver
trigger1 = !lose
trigger1 = NumExplod(9876) = 0
