;END BLOOD
[Statedef 8012]
type    = A
movetype= I
physics = N
ctrl = 0
anim = 1019

[State 3, 1]
type = SprPriority
trigger1 = root,Var(49)>=1
trigger1 = 1
value = 55
ignorehitpause = 1

[State 7, Blood_sound]
type = PlaySnd
trigger1 = root,var(25) = 1
trigger1 = animelem = 1
value = S5,ifelse(random<=500,0,ifelse(random>500,1,2))
volumescale = 90

[State 7, blood_sound]
type = PlaySnd
trigger1 = !IsHelper(8013)
trigger1 = root,var(25) = 0
trigger1 = animelem = 1
value = S6,ifelse(random<=500,0,ifelse(random>500,1,2))
volumescale = 90

[State 7, blood_sound]
type = PlaySnd
trigger1 = IsHelper(8013)
trigger1 = random <200
trigger1 = root,var(25) = 0
trigger1 = animelem = 1
value = S6,ifelse(random<=500,0,ifelse(random>500,-1,2))
volumescale = 90

[State ]
type = velset
trigger1 = 1
y = 0
x = 0

[State ]
type = posset
trigger1 = 1
y = 6

[State ]
type = assertspecial
trigger1 = 1
flag = noshadow

[State end]
type = destroyself
trigger1 = time = 35

