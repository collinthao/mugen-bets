;-------------------------------------------------------------------
;BLOOD SPLAT 1 & 2
[Statedef 8000]
type = S
movetype = I
physics = N
anim = ifelse(ishelper(8000),1020,ifelse(ishelper(8001),1021,1022))

[State 1000, 3]
type = SprPriority
trigger1 = 1
value = 30

[State ]
type = velset
trigger1 = 1
x = ifelse(ishelper(8002),-2,0)
y = 0

[State ]
type = assertspecial
trigger1 = 1
flag = noshadow

[State end]
type = Destroyself
trigger1 = animtime = 0


