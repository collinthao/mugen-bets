;BLOOD BATH L
[Statedef 8010]
type    = A
movetype= I
physics = N
velset = 0,0
ctrl = 0
sprpriority = 3

[State y]
type = VarRandom
trigger1 = 1
v = 0
range = -3,-6
[State x]
type = VarRandom
trigger1 = 1
v = 1
range = -1,-4

[State ]
type = velset
trigger1 = time = 1
y = var(0)
x = var(1)

[State end]
type = changeanim
trigger1 = time = 0
value = 1017

[State ]
type = veladd
trigger1 = time >= 3
y = .1

[State ]
type = veladd
trigger1 = time >= 10
y = .2

[State ]
type = assertspecial
trigger1 = 1
flag = noshadow

[State 1000, 3]
type = SprPriority
trigger1 = 1
value = 20

[State end]
type = changestate
triggerall = time >= 5
trigger1 = (Vel Y > 0)&&(Pos Y >= 0)
value = 8012

