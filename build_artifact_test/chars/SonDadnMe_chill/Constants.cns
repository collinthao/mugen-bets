;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State 61, Hold Back]
type = veladd
triggerall = statetype = a
triggerall = ctrl
trigger1 = var(59) <= 0
trigger1 = Command = "holdback" 
trigger2 = var(59) >= 1 ; Where if the AI is active
trigger2 = p2bodydist X <= -10; If the Opponent is Behind in 10 pixels
x = -.1

[State 61, Hold FWD]
type = veladd
triggerall = statetype = a
triggerall = ctrl
trigger1 = var(59) <= 0
trigger1 = Command = "holdfwd" 
trigger2 = var(59) >= 1 ; Where if the AI is active
trigger2 = p2bodydist X >= 10; If the Opponent is Foward in 10 pixels
x = .1

[State Do not float]
type = PosSet
trigger1 = stateno = 200 || stateno = 400
trigger2 = stateno = 210 || stateno = 410
trigger3 = stateno = 220 || stateno = 420
trigger4 = stateno = 230 || stateno = 430
trigger5 = stateno = 240 || stateno = 440
trigger6 = stateno = 250 || stateno = 450
triggerall = prevstateno = 100
y = 0
